//@version=6
// Урок 21.02.2023 · Speed of Tape
// пример↑/↓ + план куда должна идти цена + куда реально (тейк/стоп/мимо)
indicator("65 SpeedTape", overlay = true, max_labels_count = 120, max_lines_count = 120)

grp = "План"
volMult   = input.float(1.3, "Объём × SMA", minval = 1.0, step = 0.1, group = grp)
speedMult = input.float(1.5, "Плотность × SMA", minval = 1.1, step = 0.1, group = grp)
wickPct   = input.float(30.0, "Тень отбоя %", minval = 20, maxval = 70, group = grp)
tpR       = input.float(2.0, "Тейк = риск ×", minval = 1.0, step = 0.5, group = grp)
slPad     = input.float(0.1, "Запас стопа × ATR", minval = 0.0, step = 0.05, group = grp)
liveAtr   = input.float(0.5, "СЕЙЧАС если ≤ ATR× от входа", minval = 0.1, step = 0.05, group = grp)
freshBars = input.int(5, "Сигнал N свечей", minval = 1, maxval = 15, group = grp)
atrLen    = input.int(14, "ATR", group = grp)
showHist  = input.bool(true, "Примеры на истории", group = grp)
lookN     = input.int(25, "Свечей на исход примера", minval = 5, maxval = 80, group = grp)
histDraw  = input.int(8, "Сколько примеров с планом/исходом", minval = 1, maxval = 20, group = grp)

colGo = #0ECB81
colStop = #F6465D
colTp = #3B82F6
colWait = #848E9C
colLate = #F6465D
colNow = #F0B90B
colSpeed = #F0B90B
colMiss = #848E9C

atr = ta.atr(atrLen)
volSma = ta.sma(volume, 20)
rng = math.max(high - low, syminfo.mintick)
upW = (high - math.max(open, close)) / rng * 100.0
loW = (math.min(open, close) - low) / rng * 100.0

density = volume / rng
densSma = ta.sma(density, 20)
active = density > densSma * speedMult or volume > volSma * volMult

speedLong = active and loW >= wickPct and close > (high + low) / 2.0
speedShort = active and upW >= wickPct and close < (high + low) / 2.0

pad = slPad * atr
float entry = na
float stop = na
float take = na
int side = 0
string mode = ""

if speedLong
    e = (low + close) / 2.0
    s = low - pad
    r = e - s
    if r > 0
        entry := e
        stop := s
        take := e + tpR * r
        side := 1
        mode := "Speed+Vol · отбой снизу"

if speedShort and na(entry)
    e = (high + close) / 2.0
    s = high + pad
    r = s - e
    if r > 0
        entry := e
        stop := s
        take := e - tpR * r
        side := -1
        mode := "Speed+Vol · отбой сверху"

var float eMem = na
var float sMem = na
var float tMem = na
var int sideMem = 0
var string modeMem = ""
var int bornMem = na

if not na(entry) and side != 0
    eMem := entry
    sMem := stop
    tMem := take
    sideMem := side
    modeMem := mode
    bornMem := bar_index

haveSig = not na(eMem) and not na(bornMem) and (bar_index - bornMem) <= freshBars
if haveSig
    entry := eMem
    stop := sMem
    take := tMem
    side := sideMem
    mode := modeMem
else
    eMem := na
    sMem := na
    tMem := na
    sideMem := 0
    modeMem := ""
    bornMem := na
    entry := na
    stop := na
    take := na
    side := 0
    mode := ""

nearEntry = haveSig and math.abs(close - entry) <= liveAtr * atr
late = haveSig and not nearEntry and (side == 1 ? close > entry : close < entry)
status = not haveSig ? "WAIT" : nearEntry ? "NOW" : late ? "LATE" : "WAIT_FILL"

barcolor(active ? color.new(colSpeed, 50) : na)

plotshape(showHist and speedLong, "пример↑", shape.triangleup, location.belowbar, colGo, size = size.small, text = "пример↑", textcolor = colGo)
plotshape(showHist and speedShort, "пример↓", shape.triangledown, location.abovebar, colStop, size = size.small, text = "пример↓", textcolor = colStop)

// ——— после примера: план + куда реально ———
var array<int>   exBi   = array.new_int()
var array<int>   exSide = array.new_int()
var array<float> exE    = array.new_float()
var array<float> exS    = array.new_float()
var array<float> exT    = array.new_float()
var array<int>   exOut  = array.new_int()
var array<int>   exAge  = array.new_int()

pushEx(int bi, int sSide, float e0, float s0, float t0) =>
    array.push(exBi, bi)
    array.push(exSide, sSide)
    array.push(exE, e0)
    array.push(exS, s0)
    array.push(exT, t0)
    array.push(exOut, 0)
    array.push(exAge, 0)
    maxKeep = histDraw + 5
    while array.size(exBi) > maxKeep
        array.shift(exBi)
        array.shift(exSide)
        array.shift(exE)
        array.shift(exS)
        array.shift(exT)
        array.shift(exOut)
        array.shift(exAge)

if barstate.isconfirmed and showHist and (speedLong or speedShort) and not na(entry) and side != 0
    pushEx(bar_index, side, entry, stop, take)

if showHist and array.size(exBi) > 0
    for i = 0 to array.size(exBi) - 1
        int o = array.get(exOut, i)
        int bi0 = array.get(exBi, i)
        if o == 0 and bar_index > bi0
            int age = array.get(exAge, i) + 1
            array.set(exAge, i, age)
            int sSide = array.get(exSide, i)
            float s0 = array.get(exS, i)
            float t0 = array.get(exT, i)
            if sSide == 1
                if low <= s0
                    array.set(exOut, i, -1)
                else if high >= t0
                    array.set(exOut, i, 1)
            else
                if high >= s0
                    array.set(exOut, i, -1)
                else if low <= t0
                    array.set(exOut, i, 1)
            if array.get(exOut, i) == 0 and age >= lookN
                array.set(exOut, i, 2)

var array<line> histLines = array.new_line()
var array<label> histLabs = array.new_label()

if barstate.islast and showHist
    if array.size(histLines) > 0
        for k = 0 to array.size(histLines) - 1
            line.delete(array.get(histLines, k))
        array.clear(histLines)
    if array.size(histLabs) > 0
        for k = 0 to array.size(histLabs) - 1
            label.delete(array.get(histLabs, k))
        array.clear(histLabs)
    nEx = array.size(exBi)
    if nEx > 0
        fromIdx = math.max(0, nEx - histDraw)
        for i = fromIdx to nEx - 1
            bi = array.get(exBi, i)
            sSide = array.get(exSide, i)
            e0 = array.get(exE, i)
            s0 = array.get(exS, i)
            t0 = array.get(exT, i)
            outc = array.get(exOut, i)
            x2 = bi + lookN
            cPlan = sSide == 1 ? colGo : colStop
            array.push(histLines, line.new(bi, e0, x2, e0, color = color.new(cPlan, 35), width = 2, style = line.style_dashed))
            array.push(histLines, line.new(bi, s0, x2, s0, color = color.new(colStop, 50), width = 1, style = line.style_dotted))
            array.push(histLines, line.new(bi, t0, x2, t0, color = color.new(colTp, 35), width = 2, style = line.style_dashed))
            array.push(histLines, line.new(bi, e0, bi + math.max(3, int(lookN * 0.35)), t0, color = color.new(colTp, 15), width = 2))
            outTxt = outc == 1 ? "реально → ТЕЙК ✓" : outc == -1 ? "реально → СТОП ✗" : outc == 2 ? "реально → мимо" : "ещё идёт…"
            planTxt = sSide == 1 ? "план: ВВЕРХ к тейку" : "план: ВНИЗ к тейку"
            yLab = sSide == 1 ? math.min(e0, t0) : math.max(e0, t0)
            array.push(histLabs, label.new(bi + int(lookN * 0.5), yLab, planTxt + "\n" + outTxt, style = label.style_label_center, color = color.new(outc == 1 ? colGo : outc == -1 ? colStop : colMiss, 10), textcolor = color.white, size = size.small))

var line lnE = na
var line lnS = na
var line lnT = na
var label lb = na
var label lbE = na
var label lbS = na
var label lbT = na

if barstate.islast
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT)
    label.delete(lb)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lbT)
    x2 = bar_index + 8

    if status == "WAIT"
        lb := label.new(x2, close, "СЕЙЧАС НЕ ВХОДИ\nпример↑ = план ВВЕРХ\nпример↓ = план ВНИЗ\nподпись у линий = куда реально\nвход только при СЕЙЧАС", style = label.style_label_left, color = color.new(colWait, 10), textcolor = color.white, size = size.normal)
    else if status == "LATE"
        lb := label.new(x2, close, "ОПОЗДАЛ · не догоняй", style = label.style_label_left, color = color.new(colLate, 5), textcolor = color.white, size = size.large)
    else
        sideTxt = side == 1 ? (status == "NOW" ? "ЛОНГ СЕЙЧАС" : "ЛОНГ · жди вход") : (status == "NOW" ? "ШОРТ СЕЙЧАС" : "ШОРТ · жди вход")
        col = side == 1 ? colGo : colStop
        lb := label.new(x2, entry, sideTxt + "\n" + mode + "\n1 вход  2 стоп  3 тейк", style = label.style_label_left, color = color.new(col, 0), textcolor = color.white, size = size.large)
        lnE := line.new(nz(bornMem, bar_index), entry, x2, entry, color = colGo, width = 4)
        lnS := line.new(nz(bornMem, bar_index), stop, x2, stop, color = colStop, width = 3)
        lnT := line.new(nz(bornMem, bar_index), take, x2, take, color = colTp, width = 3)
        lbE := label.new(x2, entry, "1 ВХОД " + str.tostring(entry, format.mintick), style = label.style_label_left, color = colGo, textcolor = color.white, size = size.normal)
        lbS := label.new(x2, stop, "2 СТОП " + str.tostring(stop, format.mintick), style = label.style_label_left, color = colStop, textcolor = color.white, size = size.normal)
        lbT := label.new(x2, take, "3 ТЕЙК " + str.tostring(take, format.mintick), style = label.style_label_left, color = colTp, textcolor = color.white, size = size.normal)

var table t = table.new(position.top_right, 1, 3, bgcolor = color.new(#0B0E11, 0), border_width = 1, border_color = #2B3139)
if barstate.islast
    big = status == "NOW" ? (side == 1 ? "👉 ЛОНГ СЕЙЧАС" : "👉 ШОРТ СЕЙЧАС") : status == "LATE" ? "⛔ ОПОЗДАЛ" : status == "WAIT_FILL" ? "⏳ жди ВХОД" : "⏳ ЖДИ"
    table.cell(t, 0, 0, big, text_color = status == "NOW" ? colGo : status == "LATE" ? colLate : colNow, text_size = size.large)
    table.cell(t, 0, 1, haveSig ? (mode + "\nвход " + str.tostring(entry, format.mintick) + " | стоп " + str.tostring(stop, format.mintick) + " | тейк " + str.tostring(take, format.mintick)) : "у примера: пунктир=план, подпись=куда реально", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, "Алерт: колокол → 65 SpeedTape → Any alert()", text_color = #848E9C, text_size = size.tiny)

newLong = speedLong and not na(bornMem) and bar_index == bornMem and side == 1
newShort = speedShort and not na(bornMem) and bar_index == bornMem and side == -1
goLong = status == "NOW" and side == 1 and not (status[1] == "NOW" and side[1] == 1)
goShort = status == "NOW" and side == -1 and not (status[1] == "NOW" and side[1] == -1)

if barstate.isconfirmed
    if newLong
        alert("SPEED↑ ЛОНГ · " + syminfo.ticker + " · вход " + str.tostring(entry, format.mintick), alert.freq_once_per_bar_close)
    if newShort
        alert("SPEED↓ ШОРТ · " + syminfo.ticker + " · вход " + str.tostring(entry, format.mintick), alert.freq_once_per_bar_close)
    if goLong and not newLong
        alert("ЛОНГ СЕЙЧАС · " + syminfo.ticker, alert.freq_once_per_bar_close)
    if goShort and not newShort
        alert("ШОРТ СЕЙЧАС · " + syminfo.ticker, alert.freq_once_per_bar_close)

alertcondition(newLong, title = "Speed лонг", message = "ЛОНГ Speed")
alertcondition(newShort, title = "Speed шорт", message = "ШОРТ Speed")
alertcondition(goLong, title = "Лонг сейчас", message = "ЛОНГ СЕЙЧАС")
alertcondition(goShort, title = "Шорт сейчас", message = "ШОРТ СЕЙЧАС")
