//@version=6
// Урок 21.02.2023 · Speed of Tape — простой учебный индикатор
indicator("65 SpeedTape", overlay = true, max_labels_count = 60, max_lines_count = 40)

grp = "План"
volMult   = input.float(1.3, "Объём × SMA", minval = 1.0, step = 0.1, group = grp)
speedMult = input.float(1.5, "Плотность × SMA", minval = 1.1, step = 0.1, group = grp)
wickPct   = input.float(30.0, "Тень отбоя %", minval = 20, maxval = 70, group = grp)
tpR       = input.float(2.0, "Тейк = риск ×", minval = 1.0, step = 0.5, group = grp)
slPad     = input.float(0.1, "Запас стопа × ATR", minval = 0.0, step = 0.05, group = grp)
liveAtr   = input.float(0.5, "СЕЙЧАС если ≤ ATR× от входа", minval = 0.1, step = 0.05, group = grp)
freshBars = input.int(5, "Сигнал N свечей", minval = 1, maxval = 15, group = grp)
atrLen    = input.int(14, "ATR", group = grp)
showHist  = input.bool(true, "Примеры на истории", group = grp)
lookN     = input.int(20, "Свечей ждать исход", minval = 5, maxval = 60, group = grp)
histDraw  = input.int(4, "Сколько примеров разбирать", minval = 1, maxval = 10, group = grp)

colGo = #0ECB81
colStop = #F6465D
colTp = #3B82F6
colWait = #2B3139
colLate = #F6465D
colNow = #F0B90B
colSpeed = #F0B90B
colMiss = #848E9C

atr = ta.atr(atrLen)
volSma = ta.sma(volume, 20)
rng = math.max(high - low, syminfo.mintick)
upW = (high - math.max(open, close)) / rng * 100.0
loW = (math.min(open, close) - low) / rng * 100.0

density = volume / rng
densSma = ta.sma(density, 20)
active = density > densSma * speedMult or volume > volSma * volMult

speedLong = active and loW >= wickPct and close > (high + low) / 2.0
speedShort = active and upW >= wickPct and close < (high + low) / 2.0

pad = slPad * atr
float entry = na
float stop = na
float take = na
int side = 0
string mode = ""

if speedLong
    e = (low + close) / 2.0
    s = low - pad
    r = e - s
    if r > 0
        entry := e
        stop := s
        take := e + tpR * r
        side := 1
        mode := "отбой снизу"

if speedShort and na(entry)
    e = (high + close) / 2.0
    s = high + pad
    r = s - e
    if r > 0
        entry := e
        stop := s
        take := e - tpR * r
        side := -1
        mode := "отбой сверху"

var float eMem = na
var float sMem = na
var float tMem = na
var int sideMem = 0
var string modeMem = ""
var int bornMem = na

if not na(entry) and side != 0
    eMem := entry
    sMem := stop
    tMem := take
    sideMem := side
    modeMem := mode
    bornMem := bar_index

haveSig = not na(eMem) and not na(bornMem) and (bar_index - bornMem) <= freshBars
if haveSig
    entry := eMem
    stop := sMem
    take := tMem
    side := sideMem
    mode := modeMem
else
    eMem := na
    sMem := na
    tMem := na
    sideMem := 0
    modeMem := ""
    bornMem := na
    entry := na
    stop := na
    take := na
    side := 0
    mode := ""

nearEntry = haveSig and math.abs(close - entry) <= liveAtr * atr
late = haveSig and not nearEntry and (side == 1 ? close > entry : close < entry)
status = not haveSig ? "WAIT" : nearEntry ? "NOW" : late ? "LATE" : "WAIT_FILL"

// жёлтая = был всплеск объёма/плотности
barcolor(active ? color.new(colSpeed, 55) : na)

// мелкие метки-примеры
plotshape(showHist and speedLong, title = "+", style = shape.triangleup, location = location.belowbar, color = colGo, size = size.tiny)
plotshape(showHist and speedShort, title = "-", style = shape.triangledown, location = location.abovebar, color = colStop, size = size.tiny)

// буфер примеров → исход
var array<int>   exBi   = array.new_int()
var array<int>   exSide = array.new_int()
var array<float> exE    = array.new_float()
var array<float> exS    = array.new_float()
var array<float> exT    = array.new_float()
var array<int>   exOut  = array.new_int()
var array<int>   exAge  = array.new_int()

pushEx(int bi, int sSide, float e0, float s0, float t0) =>
    array.push(exBi, bi)
    array.push(exSide, sSide)
    array.push(exE, e0)
    array.push(exS, s0)
    array.push(exT, t0)
    array.push(exOut, 0)
    array.push(exAge, 0)
    while array.size(exBi) > histDraw + 3
        array.shift(exBi)
        array.shift(exSide)
        array.shift(exE)
        array.shift(exS)
        array.shift(exT)
        array.shift(exOut)
        array.shift(exAge)

if barstate.isconfirmed and showHist and (speedLong or speedShort) and not na(entry) and side != 0
    pushEx(bar_index, side, entry, stop, take)

if showHist and array.size(exBi) > 0
    for i = 0 to array.size(exBi) - 1
        if array.get(exOut, i) == 0 and bar_index > array.get(exBi, i)
            age = array.get(exAge, i) + 1
            array.set(exAge, i, age)
            sSide = array.get(exSide, i)
            s0 = array.get(exS, i)
            t0 = array.get(exT, i)
            if sSide == 1
                if low <= s0
                    array.set(exOut, i, -1)
                else if high >= t0
                    array.set(exOut, i, 1)
            else
                if high >= s0
                    array.set(exOut, i, -1)
                else if low <= t0
                    array.set(exOut, i, 1)
            if array.get(exOut, i) == 0 and age >= lookN
                array.set(exOut, i, 2)

var array<line> histLines = array.new_line()
var array<label> histLabs = array.new_label()

if barstate.islast and showHist
    if array.size(histLines) > 0
        for k = 0 to array.size(histLines) - 1
            line.delete(array.get(histLines, k))
        array.clear(histLines)
    if array.size(histLabs) > 0
        for k = 0 to array.size(histLabs) - 1
            label.delete(array.get(histLabs, k))
        array.clear(histLabs)

    nEx = array.size(exBi)
    if nEx > 0
        fromIdx = math.max(0, nEx - histDraw)
        for i = fromIdx to nEx - 1
            bi = array.get(exBi, i)
            sSide = array.get(exSide, i)
            e0 = array.get(exE, i)
            t0 = array.get(exT, i)
            outc = array.get(exOut, i)
            // одна стрелка: от входа к тейку = КУДА ДОЛЖНА была идти
            array.push(histLines, line.new(bi, e0, bi + math.max(4, int(lookN * 0.4)), t0, color = color.new(colTp, 20), width = 3))
            dir = sSide == 1 ? "ВВЕРХ" : "ВНИЗ"
            res = outc == 1 ? "сработало: ТЕЙК" : outc == -1 ? "не сработало: СТОП" : outc == 2 ? "мимо" : "ещё идёт"
            txt = (sSide == 1 ? "ЛОНГ" : "ШОРТ") + " · план " + dir + "\n" + res
            y = sSide == 1 ? e0 : e0
            array.push(histLabs, label.new(bi + 2, y, txt, style = sSide == 1 ? label.style_label_up : label.style_label_down, color = color.new(outc == 1 ? colGo : outc == -1 ? colStop : colMiss, 5), textcolor = color.white, size = size.normal))

var line lnE = na
var line lnS = na
var line lnT = na
var label lb = na
var label lbE = na
var label lbS = na
var label lbT = na

if barstate.islast
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT)
    label.delete(lb)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lbT)
    x2 = bar_index + 6

    if status == "WAIT"
        lb := label.new(x2, close, "НЕ ВХОДИ СЕЙЧАС\n\n▲ зелёный = учебный ЛОНГ\n▼ красный = учебный ШОРТ\nсиняя стрелка = куда план\nподпись = сработало или нет\n\nЖди статус СЕЙЧАС", style = label.style_label_left, color = color.new(colWait, 0), textcolor = color.white, size = size.normal)
    else if status == "LATE"
        lb := label.new(x2, close, "ОПОЗДАЛ\nне догоняй", style = label.style_label_left, color = color.new(colLate, 0), textcolor = color.white, size = size.large)
    else
        sideTxt = side == 1 ? (status == "NOW" ? "ЛОНГ СЕЙЧАС" : "ЛОНГ · жди цену") : (status == "NOW" ? "ШОРТ СЕЙЧАС" : "ШОРТ · жди цену")
        col = side == 1 ? colGo : colStop
        lb := label.new(x2, entry, sideTxt + "\n" + mode, style = label.style_label_left, color = color.new(col, 0), textcolor = color.white, size = size.large)
        lnE := line.new(nz(bornMem, bar_index), entry, x2, entry, color = colGo, width = 4)
        lnS := line.new(nz(bornMem, bar_index), stop, x2, stop, color = colStop, width = 3)
        lnT := line.new(nz(bornMem, bar_index), take, x2, take, color = colTp, width = 3)
        lbE := label.new(x2, entry, "1 ВХОД", style = label.style_label_left, color = colGo, textcolor = color.white, size = size.small)
        lbS := label.new(x2, stop, "2 СТОП", style = label.style_label_left, color = colStop, textcolor = color.white, size = size.small)
        lbT := label.new(x2, take, "3 ТЕЙК", style = label.style_label_left, color = colTp, textcolor = color.white, size = size.small)

var table t = table.new(position.top_right, 1, 4, bgcolor = color.new(#0B0E11, 0), border_width = 1, border_color = #2B3139)
if barstate.islast
    big = status == "NOW" ? (side == 1 ? "ЛОНГ СЕЙЧАС" : "ШОРТ СЕЙЧАС") : status == "LATE" ? "ОПОЗДАЛ" : status == "WAIT_FILL" ? "жди ВХОД" : "ЖДИ"
    table.cell(t, 0, 0, big, text_color = status == "NOW" ? colGo : status == "LATE" ? colLate : colNow, text_size = size.large)
    table.cell(t, 0, 1, "Жёлтая свеча = всплеск Speed/Vol", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, "▲ лонг / ▼ шорт — только примеры", text_color = #848E9C, text_size = size.small)
    table.cell(t, 0, 3, "Синяя линия = план · подпись = итог", text_color = #848E9C, text_size = size.small)

newLong = speedLong and not na(bornMem) and bar_index == bornMem and side == 1
newShort = speedShort and not na(bornMem) and bar_index == bornMem and side == -1
goLong = status == "NOW" and side == 1 and not (status[1] == "NOW" and side[1] == 1)
goShort = status == "NOW" and side == -1 and not (status[1] == "NOW" and side[1] == -1)

if barstate.isconfirmed
    if newLong
        alert("SPEED ЛОНГ · " + syminfo.ticker, alert.freq_once_per_bar_close)
    if newShort
        alert("SPEED ШОРТ · " + syminfo.ticker, alert.freq_once_per_bar_close)
    if goLong and not newLong
        alert("ЛОНГ СЕЙЧАС · " + syminfo.ticker, alert.freq_once_per_bar_close)
    if goShort and not newShort
        alert("ШОРТ СЕЙЧАС · " + syminfo.ticker, alert.freq_once_per_bar_close)

alertcondition(newLong, title = "Speed лонг", message = "ЛОНГ")
alertcondition(newShort, title = "Speed шорт", message = "ШОРТ")
alertcondition(goLong, title = "Лонг сейчас", message = "ЛОНГ СЕЙЧАС")
alertcondition(goShort, title = "Шорт сейчас", message = "ШОРТ СЕЙЧАС")
