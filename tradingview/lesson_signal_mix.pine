//@version=6
// 65 Signal Mix — микс уроков + старых скриптов.
// На графике ТОЛЬКО: сигнал · почему · рисунок причины · вход/стоп/тейк с ценой.
// Остальные модули считают в фоне и голосуют (конфлюенс).
indicator("65 Signal Mix", overlay = true, max_labels_count = 100, max_lines_count = 80, max_boxes_count = 30)

grp = "Сигнал"
minVotes   = input.int(2, "Мин. совпадений (точность)", minval = 1, maxval = 6, group = grp, tooltip = "Сколько модулей должны сказать в одну сторону. 2–3 = точнее, меньше спама.")
tp1R       = input.float(1.0, "ТЕЙК1 = риск ×", minval = 0.5, step = 0.25, group = grp)
tp2R       = input.float(2.0, "ТЕЙК2 = риск ×", minval = 0.5, step = 0.25, group = grp)
tp3R       = input.float(3.0, "ТЕЙК3 = риск ×", minval = 0.5, step = 0.25, group = grp)
slPad      = input.float(0.12, "Запас стопа × ATR", minval = 0.0, step = 0.05, group = grp)
freshBars  = input.int(6, "Держать сигнал N свечей", minval = 2, maxval = 20, group = grp)
cooldown   = input.int(8, "Пауза между сигналами", minval = 3, maxval = 40, group = grp)
liveAtr    = input.float(0.7, "СЕЙЧАС если ≤ ATR× от входа", minval = 0.1, step = 0.05, group = grp)
needHtf    = input.bool(true, "Фильтр EMA тренда", group = grp)
emaFast    = input.int(20, "EMA fast", group = grp)
emaSlow    = input.int(50, "EMA slow", group = grp)
atrLen     = input.int(14, "ATR", group = grp)
volMult    = input.float(1.25, "Объём × SMA", minval = 1.0, step = 0.05, group = grp)
showHist   = input.bool(true, "Мелкие метки прошлых сигналов", group = grp)
leverage   = input.float(20.0, "Плечо (для % маржи в подписи)", minval = 1, step = 1, group = grp)

grpM = "Модули уроков (фон)"
useSweep   = input.bool(true, "Свип (MATIC)", group = grpM)
useBrake   = input.bool(true, "Тормозной бар", group = grpM)
useTape    = input.bool(true, "Speed / плотность", group = grpM)
useDr      = input.bool(true, "DR тень 65%", group = grpM)
useTl      = input.bool(true, "Пробой трендовой", group = grpM)
useZone    = input.bool(true, "Защита / пробой зоны", group = grpM)
useOb      = input.bool(true, "ОБ импульс + ретест", group = grpM)
useIb      = input.bool(true, "Слом инсайд-бара", group = grpM)

grpOld = "Модули старого mix_map (фон)"
useFib     = input.bool(true, "SK Fib 0.5–0.618", group = grpOld)
useBos     = input.bool(true, "BOS/CHoCH ретест", group = grpOld)
useFvg     = input.bool(true, "FVG fill", group = grpOld)
useZ146    = input.bool(true, "Z146 уровень", group = grpOld)
useEmaPb   = input.bool(true, "EMA откат по тренду", group = grpOld)
useAsia    = input.bool(true, "Пробой Asian range", group = grpOld)
useSqueeze = input.bool(true, "Пробой сжатия", group = grpOld)
useDouble  = input.bool(true, "Двойное дно/вершина", group = grpOld)
useSwRet   = input.bool(true, "Sweep + ретест (карта)", group = grpOld)
fibPivot   = input.int(5, "Fib pivot", minval = 2, maxval = 15, group = grpOld)
fibMinAtr  = input.float(2.0, "Fib мин импульс × ATR", minval = 0.5, step = 0.5, group = grpOld)
sqBars     = input.int(12, "Сжатие: свечей", group = grpOld)
sqAtrMult  = input.float(2.5, "Сжатие: ширина × ATR", group = grpOld)

colGo = #0ECB81
colStop = #F6465D
colTp = #3B82F6
colWait = #2B3139
colLate = #F6465D
colNow = #F0B90B
colWhy = #F0B90B
colMiss = #848E9C

atr = ta.atr(atrLen)
volSma = ta.sma(volume, 20)
hiVol = volume > volSma * volMult
rng = math.max(high - low, syminfo.mintick)
bodyPct = math.abs(close - open) / rng * 100.0
upW = (high - math.max(open, close)) / rng * 100.0
loW = (math.min(open, close) - low) / rng * 100.0
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
htfLong = not needHtf or emaF > emaS
htfShort = not needHtf or emaF < emaS
pad = slPad * atr

pxPct(e, px) => e != 0 ? math.abs(px - e) / e * 100.0 : 0.0
barMinutes() => math.max(timeframe.in_seconds() / 60.0, 1.0)
// примерно: сколько минут ждать до цели при темпе ~1 ATR / свеча (оценка, не гарантия)
etaMinutes(fromPx, toPx) =>
    float dist = math.abs(toPx - fromPx)
    float pace = math.max(atr, fromPx * 0.00005)
    int barsEta = int(math.max(1, math.ceil(dist / pace)))
    barsEta * barMinutes()
fmtWait(m) =>
    m < 60 ? "~" + str.tostring(m, "#") + " мин" : m < 1440 ? "~" + str.tostring(m / 60.0, "#.#") + " ч" : "~" + str.tostring(m / 1440.0, "#.#") + " д"

// ── модули: каждый даёт vote ±1, stop-кандидат, why, draw-тип ─────────
int vLong = 0
int vShort = 0
string whyL = ""
string whyS = ""
float stopL = na
float stopS = na
// draw codes: 1=sweepLvl 2=brakeBar 3=tape 4=drWick 5=tl 6=zone 7=ob 8=ib
int drawL = 0
int drawS = 0
float drawY1L = na
float drawY2L = na
float drawY1S = na
float drawY2S = na

// 1) СВИП (lesson_matic_short)
swingLen = 8
priorHi = ta.highest(high[1], swingLen)
priorLo = ta.lowest(low[1], swingLen)
sweepShort = useSweep and hiVol and high > priorHi and close < priorHi and upW >= 35.0 and close < (high + low) / 2.0
sweepLong  = useSweep and hiVol and low < priorLo and close > priorLo and loW >= 35.0 and close > (high + low) / 2.0
if sweepLong
    vLong += 1
    whyL += "• свип лоу\n"
    stopL := na(stopL) ? low - pad : math.min(stopL, low - pad)
    drawL := drawL == 0 ? 1 : drawL
    drawY1L := priorLo
    drawY2L := low
if sweepShort
    vShort += 1
    whyS += "• свип хая\n"
    stopS := na(stopS) ? high + pad : math.max(stopS, high + pad)
    drawS := drawS == 0 ? 1 : drawS
    drawY1S := priorHi
    drawY2S := high

// 2) ТОРМОЗ (lesson_brake_bar)
brakeBot = useBrake and hiVol and loW >= 55.0 and close > open
brakeTop = useBrake and hiVol and upW >= 55.0 and close < open
if brakeBot
    vLong += 1
    whyL += "• тормоз снизу\n"
    stopL := na(stopL) ? low - pad : math.min(stopL, low - pad)
    if drawL == 0
        drawL := 2
        drawY1L := low
        drawY2L := close
if brakeTop
    vShort += 1
    whyS += "• тормоз сверху\n"
    stopS := na(stopS) ? high + pad : math.max(stopS, high + pad)
    if drawS == 0
        drawS := 2
        drawY1S := high
        drawY2S := close

// 3) SPEED / плотность (lesson_speed_tape)
density = volume / rng
densSma = ta.sma(density, 20)
active = density > densSma * 1.5 or hiVol
tapeLong = useTape and active and loW >= 30.0 and close > (high + low) / 2.0
tapeShort = useTape and active and upW >= 30.0 and close < (high + low) / 2.0
if tapeLong
    vLong += 1
    whyL += "• Speed/плотность ↑\n"
    stopL := na(stopL) ? low - pad : math.min(stopL, low - pad)
    if drawL == 0
        drawL := 3
        drawY1L := low
        drawY2L := high
if tapeShort
    vShort += 1
    whyS += "• Speed/плотность ↓\n"
    stopS := na(stopS) ? high + pad : math.max(stopS, high + pad)
    if drawS == 0
        drawS := 3
        drawY1S := low
        drawY2S := high

// 4) DR тень 65% (lesson_dr_setup)
impulseBody = hiVol and bodyPct >= 90.0
drLong = useDr and hiVol and not impulseBody and loW >= 65.0 and close > (high + low) / 2.0
drShort = useDr and hiVol and not impulseBody and upW >= 65.0 and close < (high + low) / 2.0
if drLong
    vLong += 1
    whyL += "• DR тень 65% снизу\n"
    stopL := na(stopL) ? low - pad : math.min(stopL, low - pad)
    if drawL == 0
        drawL := 4
        drawY1L := low
        drawY2L := math.min(open, close)
if drShort
    vShort += 1
    whyS += "• DR тень 65% сверху\n"
    stopS := na(stopS) ? high + pad : math.max(stopS, high + pad)
    if drawS == 0
        drawS := 4
        drawY1S := math.max(open, close)
        drawY2S := high

// 5) ТРЕНДОВАЯ (lesson_trendline_break)
pivotLen = 5
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float h1 = na
var float h2 = na
var int hb1 = na
var int hb2 = na
var float l1 = na
var float l2 = na
var int lb1 = na
var int lb2 = na
if not na(ph)
    h2 := h1
    hb2 := hb1
    h1 := ph
    hb1 := bar_index - pivotLen
if not na(pl)
    l2 := l1
    lb2 := lb1
    l1 := pl
    lb1 := bar_index - pivotLen
descTl = useTl and not na(h1) and not na(h2) and not na(hb1) and not na(hb2) and h2 > h1 and hb2 < hb1 and hb1 != hb2
ascTl  = useTl and not na(l1) and not na(l2) and not na(lb1) and not na(lb2) and l2 < l1 and lb2 < lb1 and lb1 != lb2
tlDn = descTl ? h2 + (h1 - h2) * (bar_index - hb2) / (hb1 - hb2) : na
tlUp = ascTl ? l2 + (l1 - l2) * (bar_index - lb2) / (lb1 - lb2) : na
tlDnPrev = descTl ? h2 + (h1 - h2) * (bar_index - 1 - hb2) / (hb1 - hb2) : na
tlUpPrev = ascTl ? l2 + (l1 - l2) * (bar_index - 1 - lb2) / (lb1 - lb2) : na
tlLong = descTl and not na(tlDn) and not na(tlDnPrev) and close > tlDn and close[1] <= tlDnPrev and hiVol and close > open
tlShort = ascTl and not na(tlUp) and not na(tlUpPrev) and close < tlUp and close[1] >= tlUpPrev and hiVol and close < open
if tlLong
    vLong += 1
    whyL += "• пробой ↓трендовой\n"
    stopL := na(stopL) ? math.min(nz(l1, low), low) - pad : math.min(stopL, math.min(nz(l1, low), low) - pad)
    if drawL == 0
        drawL := 5
        drawY1L := h2
        drawY2L := tlDn
if tlShort
    vShort += 1
    whyS += "• пробой ↑трендовой\n"
    stopS := na(stopS) ? math.max(nz(h1, high), high) + pad : math.max(stopS, math.max(nz(h1, high), high) + pad)
    if drawS == 0
        drawS := 5
        drawY1S := l2
        drawY2S := tlUp

// 6) ЗОНА защита/пробой (lesson_level_defense)
half = 0.25 * atr
swingZ = 5
zPh = ta.pivothigh(high, swingZ, swingZ)
zPl = ta.pivotlow(low, swingZ, swingZ)
var float zMid = na
var float zTop = na
var float zBot = na
var int zDir = 0
if not na(zPh)
    if na(zMid) or math.abs(close - zPh) <= math.abs(close - nz(zMid))
        zMid := zPh
        zTop := zPh + half
        zBot := zPh - half
        zDir := 1
if not na(zPl)
    if na(zMid) or math.abs(close - zPl) < math.abs(close - nz(zMid))
        zMid := zPl
        zTop := zPl + half
        zBot := zPl - half
        zDir := -1
defLong = useZone and not na(zMid) and zDir == -1 and low <= zTop and close > zMid and close > open
defShort = useZone and not na(zMid) and zDir == 1 and high >= zBot and close < zMid and close < open
brkLong = useZone and not na(zTop) and zDir == 1 and close > zTop and close[1] <= zTop
brkShort = useZone and not na(zBot) and zDir == -1 and close < zBot and close[1] >= zBot
if defLong or brkLong
    vLong += 1
    whyL += defLong ? "• защита зоны снизу\n" : "• пробой зоны вверх\n"
    sCand = zBot - pad
    stopL := na(stopL) ? sCand : math.min(stopL, sCand)
    if drawL == 0
        drawL := 6
        drawY1L := zBot
        drawY2L := zTop
if defShort or brkShort
    vShort += 1
    whyS += defShort ? "• защита зоны сверху\n" : "• пробой зоны вниз\n"
    sCand = zTop + pad
    stopS := na(stopS) ? sCand : math.max(stopS, sCand)
    if drawS == 0
        drawS := 6
        drawY1S := zBot
        drawY2S := zTop

// 7) ОБ импульс (ob_inside classic) — ретест в окне
var float obTop = na
var float obBot = na
var int obDir = 0
var int obBorn = na
var bool obArmed = false
bullImpulse = close > open and math.abs(close - open) >= 1.2 * atr and close > high[1]
bearImpulse = close < open and math.abs(close - open) >= 1.2 * atr and close < low[1]
if useOb and bullImpulse and close[1] < open[1]
    obTop := high[1]
    obBot := low[1]
    obDir := 1
    obBorn := bar_index
    obArmed := true
if useOb and bearImpulse and close[1] > open[1]
    obTop := high[1]
    obBot := low[1]
    obDir := -1
    obBorn := bar_index
    obArmed := true
obFresh = obArmed and not na(obBorn) and (bar_index - obBorn) <= 20 and not na(obTop)
obRetLong = useOb and obFresh and obDir == 1 and low <= obTop and close >= obBot and close > open
obRetShort = useOb and obFresh and obDir == -1 and high >= obBot and close <= obTop and close < open
if obRetLong
    vLong += 1
    whyL += "• ретест ОБ↑\n"
    stopL := na(stopL) ? obBot - pad : math.min(stopL, obBot - pad)
    if drawL == 0
        drawL := 7
        drawY1L := obBot
        drawY2L := obTop
if obRetShort
    vShort += 1
    whyS += "• ретест ОБ↓\n"
    stopS := na(stopS) ? obTop + pad : math.max(stopS, obTop + pad)
    if drawS == 0
        drawS := 7
        drawY1S := obBot
        drawY2S := obTop
if obFresh and ((obDir == 1 and close < obBot) or (obDir == -1 and close > obTop))
    obArmed := false

// 8) Инсайд слом (ob_inside)
motherHigh = high[2]
motherLow = low[2]
wasInside = high[1] < motherHigh and low[1] > motherLow
ibUp = useIb and wasInside and close > motherHigh and close > open
ibDn = useIb and wasInside and close < motherLow and close < open
if ibUp
    vLong += 1
    whyL += "• слом инсайд ↑\n"
    stopL := na(stopL) ? motherLow - pad : math.min(stopL, motherLow - pad)
    if drawL == 0
        drawL := 8
        drawY1L := motherLow
        drawY2L := motherHigh
if ibDn
    vShort += 1
    whyS += "• слом инсайд ↓\n"
    stopS := na(stopS) ? motherHigh + pad : math.max(stopS, motherHigh + pad)
    if drawS == 0
        drawS := 8
        drawY1S := motherLow
        drawY2S := motherHigh

// ── старый mix_map: SK Fib / BOS / FVG / Z146 / EMA / Asia / фигуры ─────
swingMap = 5
sh1 = ta.highest(high[1], swingMap)
sl1 = ta.lowest(low[1], swingMap)
structure = emaF > emaS ? 1 : emaF < emaS ? -1 : 0

// 9) SK Fib (mix_map)
fibPh = ta.pivothigh(high, fibPivot, fibPivot)
fibPl = ta.pivotlow(low, fibPivot, fibPivot)
var float skA = na
var float skB = na
var int skABar = na
var int skBBar = na
var int skSide = 0
var float skPullExt = na
if useFib and not na(fibPh)
    phPrice = high[fibPivot]
    phBar = bar_index - fibPivot
    if skSide == 1 and not na(skA) and phBar > skABar and phPrice > skA
        skB := phPrice
        skBBar := phBar
        skPullExt := na
    else if skSide == -1 and not na(skB)
        skPullExt := na(skPullExt) ? phPrice : math.max(skPullExt, phPrice)
    else if not (skSide == -1 and not na(skA) and na(skB) and phBar >= skABar and phPrice >= skA)
        skA := phPrice
        skABar := phBar
        skB := na
        skBBar := na
        skSide := -1
        skPullExt := na
    else
        skA := phPrice
        skABar := phBar
if useFib and not na(fibPl)
    plPrice = low[fibPivot]
    plBar = bar_index - fibPivot
    if skSide == -1 and not na(skA) and plBar > skABar and plPrice < skA
        if na(skB) or plPrice <= skB
            skB := plPrice
            skBBar := plBar
            skPullExt := na
    else if skSide == 1 and not na(skB)
        skPullExt := na(skPullExt) ? plPrice : math.min(skPullExt, plPrice)
    else if not (skSide == 1 and not na(skA) and na(skB) and plBar >= skABar and plPrice <= skA)
        skA := plPrice
        skABar := plBar
        skB := na
        skBBar := na
        skSide := 1
        skPullExt := na
    else
        skA := plPrice
        skABar := plBar
if useFib and skSide < 0 and not na(skA) and close > skA
    skA := na
    skB := na
    skSide := 0
    skPullExt := na
if useFib and skSide > 0 and not na(skA) and close < skA
    skA := na
    skB := na
    skSide := 0
    skPullExt := na
skRange = not na(skA) and not na(skB) ? math.abs(skA - skB) : na
skReady = useFib and not na(skRange) and skRange >= fibMinAtr * atr and not na(skBBar) and bar_index > skBBar
skDown = skReady and skSide < 0 and skB < skA
skUp = skReady and skSide > 0 and skB > skA
skZ0 = skDown ? skA - 0.5 * skRange : skUp ? skA + 0.5 * skRange : na
skZ1 = skDown ? skA - 0.618 * skRange : skUp ? skA + 0.618 * skRange : na
skZoneTop = not na(skZ0) and not na(skZ1) ? math.max(skZ0, skZ1) : na
skZoneBot = not na(skZ0) and not na(skZ1) ? math.min(skZ0, skZ1) : na
inSkShortZone = skDown and high >= skZoneBot and low <= skZoneTop
inSkLongZone = skUp and low <= skZoneTop and high >= skZoneBot
if skDown and inSkShortZone
    skPullExt := na(skPullExt) ? high : math.max(skPullExt, high)
if skUp and inSkLongZone
    skPullExt := na(skPullExt) ? low : math.min(skPullExt, low)
bearReversal = (close < open and close[1] > open[1] and close <= open[1]) or (rng > 0 and upW >= 50.0 and bodyPct <= 35.0)
bullReversal = (close > open and close[1] < open[1] and close >= open[1]) or (rng > 0 and loW >= 50.0 and bodyPct <= 35.0)
fibShortSig = skDown and inSkShortZone and close <= skZoneTop and bearReversal
fibLongSig = skUp and inSkLongZone and close >= skZoneBot and bullReversal
if fibLongSig
    vLong += 1
    whyL += "• SK Fib лонг\n"
    sCand = math.min(nz(skPullExt, low), skZoneBot) - pad
    stopL := na(stopL) ? sCand : math.min(stopL, sCand)
    if drawL == 0
        drawL := 9
        drawY1L := skZoneBot
        drawY2L := skZoneTop
if fibShortSig
    vShort += 1
    whyS += "• SK Fib шорт\n"
    sCand = math.max(nz(skPullExt, high), skZoneTop) + pad
    stopS := na(stopS) ? sCand : math.max(stopS, sCand)
    if drawS == 0
        drawS := 9
        drawY1S := skZoneBot
        drawY2S := skZoneTop

// 10) BOS/CHoCH → ретест (mix_map)
bosUp = close > sh1 and close[1] <= sh1
bosDn = close < sl1 and close[1] >= sl1
var float pendLvl = na
var int pendSide = 0
var int pendBar = na
if useBos and bosUp
    pendLvl := sh1
    pendSide := 1
    pendBar := bar_index
if useBos and bosDn
    pendLvl := sl1
    pendSide := -1
    pendBar := bar_index
bosRetLong = useBos and pendSide == 1 and not na(pendLvl) and not na(pendBar) and bar_index > pendBar and bar_index - pendBar <= 12 and low <= pendLvl and close > pendLvl and close > open
bosRetShort = useBos and pendSide == -1 and not na(pendLvl) and not na(pendBar) and bar_index > pendBar and bar_index - pendBar <= 12 and high >= pendLvl and close < pendLvl and close < open
if bosRetLong
    vLong += 1
    whyL += structure < 0 ? "• CHoCH↑ ретест\n" : "• BOS↑ ретест\n"
    stopL := na(stopL) ? math.min(low, pendLvl) - pad : math.min(stopL, math.min(low, pendLvl) - pad)
    if drawL == 0
        drawL := 10
        drawY1L := pendLvl
        drawY2L := pendLvl
if bosRetShort
    vShort += 1
    whyS += structure > 0 ? "• CHoCH↓ ретест\n" : "• BOS↓ ретест\n"
    stopS := na(stopS) ? math.max(high, pendLvl) + pad : math.max(stopS, math.max(high, pendLvl) + pad)
    if drawS == 0
        drawS := 10
        drawY1S := pendLvl
        drawY2S := pendLvl

// 11) FVG fill (mix_map, без спама боксов)
bullGap = low > high[2] and (low - high[2]) >= 0.25 * atr
bearGap = high < low[2] and (low[2] - high) >= 0.25 * atr
var float fvgTop = na
var float fvgBot = na
var int fvgDir = 0
var int fvgBar = na
if useFvg and bullGap
    fvgTop := low
    fvgBot := high[2]
    fvgDir := 1
    fvgBar := bar_index
if useFvg and bearGap
    fvgTop := low[2]
    fvgBot := high
    fvgDir := -1
    fvgBar := bar_index
fvgAlive = useFvg and not na(fvgBar) and bar_index - fvgBar <= 30 and not na(fvgTop)
inBullFvg = fvgAlive and fvgDir == 1 and low <= fvgTop and high >= fvgBot
inBearFvg = fvgAlive and fvgDir == -1 and low <= fvgTop and high >= fvgBot
if fvgAlive and fvgDir == 1 and low <= fvgBot
    fvgDir := 0
if fvgAlive and fvgDir == -1 and high >= fvgTop
    fvgDir := 0
fvgLong = inBullFvg and close > open
fvgShort = inBearFvg and close < open
if fvgLong
    vLong += 1
    whyL += "• FVG fill ↑\n"
    stopL := na(stopL) ? fvgBot - pad : math.min(stopL, fvgBot - pad)
    if drawL == 0
        drawL := 11
        drawY1L := fvgBot
        drawY2L := fvgTop
if fvgShort
    vShort += 1
    whyS += "• FVG fill ↓\n"
    stopS := na(stopS) ? fvgTop + pad : math.max(stopS, fvgTop + pad)
    if drawS == 0
        drawS := 11
        drawY1S := fvgBot
        drawY2S := fvgTop

// 12) Z146 (mix_map)
var int z146Dir = 1
var float zExt = high
var int zExtI = 0
var float zLastP = low
var int zLastPi = 0
var float zLvl = na
var int zLvlSide = 0
bool zPiv = false
if useZ146
    if z146Dir > 0
        if high > zExt
            zExt := high
            zExtI := bar_index
        else if zExt - low >= 1.5 * atr
            zPiv := true
    else
        if low < zExt
            zExt := low
            zExtI := bar_index
        else if high - zExt >= 1.5 * atr
            zPiv := true
    if zPiv
        float zR = math.abs(zExt - zLastP)
        if zR >= 4.0 * atr and (zExtI - zLastPi) <= 24 and zLastPi > 0
            float zL = zLastP + z146Dir * 0.146 * zR
            bool zPassed = (z146Dir > 0 and low <= zL) or (z146Dir < 0 and high >= zL)
            if not zPassed
                zLvl := zL
                zLvlSide := z146Dir
        zLastP := zExt
        zLastPi := zExtI
        z146Dir := -z146Dir
        zExt := z146Dir > 0 ? high : low
        zExtI := bar_index
z146Long = useZ146 and not na(zLvl) and zLvlSide > 0 and low <= zLvl and close > zLvl and close > open
z146Short = useZ146 and not na(zLvl) and zLvlSide < 0 and high >= zLvl and close < zLvl and close < open
if z146Long
    vLong += 1
    whyL += "• Z146\n"
    stopL := na(stopL) ? math.min(low, zLvl) - pad : math.min(stopL, math.min(low, zLvl) - pad)
    if drawL == 0
        drawL := 12
        drawY1L := zLvl
        drawY2L := zLvl
if z146Short
    vShort += 1
    whyS += "• Z146\n"
    stopS := na(stopS) ? math.max(high, zLvl) + pad : math.max(stopS, math.max(high, zLvl) + pad)
    if drawS == 0
        drawS := 12
        drawY1S := zLvl
        drawY2S := zLvl

// 13) EMA откат
emaLong = useEmaPb and htfLong and low <= emaF and close > emaF and close > open
emaShort = useEmaPb and htfShort and high >= emaF and close < emaF and close < open
if emaLong
    vLong += 1
    whyL += "• EMA откат ↑\n"
    stopL := na(stopL) ? math.min(low, emaF) - pad : math.min(stopL, math.min(low, emaF) - pad)
    if drawL == 0
        drawL := 13
        drawY1L := emaF
        drawY2L := emaF
if emaShort
    vShort += 1
    whyS += "• EMA откат ↓\n"
    stopS := na(stopS) ? math.max(high, emaF) + pad : math.max(stopS, math.max(high, emaF) + pad)
    if drawS == 0
        drawS := 13
        drawY1S := emaF
        drawY2S := emaF

// 14) Asian range
asiaHour = hour(time, "UTC")
inAsia = asiaHour >= 0 and asiaHour < 8
var float asiaHi = na
var float asiaLo = na
var int asiaDay = na
curDay = dayofmonth(time, "UTC")
if useAsia and (na(asiaDay) or curDay != asiaDay)
    asiaDay := curDay
    asiaHi := na
    asiaLo := na
if useAsia and inAsia
    asiaHi := na(asiaHi) ? high : math.max(asiaHi, high)
    asiaLo := na(asiaLo) ? low : math.min(asiaLo, low)
asiaLong = useAsia and not inAsia and not na(asiaHi) and not na(asiaLo) and asiaHi > asiaLo and close > asiaHi and close[1] <= asiaHi
asiaShort = useAsia and not inAsia and not na(asiaHi) and not na(asiaLo) and asiaHi > asiaLo and close < asiaLo and close[1] >= asiaLo
if asiaLong
    vLong += 1
    whyL += "• Asian break ↑\n"
    stopL := na(stopL) ? asiaLo - pad : math.min(stopL, asiaLo - pad)
    if drawL == 0
        drawL := 14
        drawY1L := asiaLo
        drawY2L := asiaHi
if asiaShort
    vShort += 1
    whyS += "• Asian break ↓\n"
    stopS := na(stopS) ? asiaHi + pad : math.max(stopS, asiaHi + pad)
    if drawS == 0
        drawS := 14
        drawY1S := asiaLo
        drawY2S := asiaHi

// 15) Сжатие
sqHigh = ta.highest(high, sqBars)
sqLow = ta.lowest(low, sqBars)
inSqueeze = (sqHigh - sqLow) <= sqAtrMult * atr and (sqHigh - sqLow) > 0
sqUp = useSqueeze and inSqueeze[1] and close > sqHigh[1] and close[1] <= sqHigh[1]
sqDn = useSqueeze and inSqueeze[1] and close < sqLow[1] and close[1] >= sqLow[1]
if sqUp
    vLong += 1
    whyL += "• пробой сжатия ↑\n"
    stopL := na(stopL) ? sqLow[1] - pad : math.min(stopL, sqLow[1] - pad)
    if drawL == 0
        drawL := 15
        drawY1L := sqLow[1]
        drawY2L := sqHigh[1]
if sqDn
    vShort += 1
    whyS += "• пробой сжатия ↓\n"
    stopS := na(stopS) ? sqHigh[1] + pad : math.max(stopS, sqHigh[1] + pad)
    if drawS == 0
        drawS := 15
        drawY1S := sqLow[1]
        drawY2S := sqHigh[1]

// 16) Двойное дно/вершина
var float p1L = na
var float p2L = na
var int p1Lb = na
var int p2Lb = na
var float p1H = na
var float p2H = na
var int p1Hb = na
var int p2Hb = na
var float neckL = na
var float neckH = na
var float extL = na
var float extH = na
if useDouble and not na(pl)
    p1L := p2L
    p1Lb := p2Lb
    p2L := pl
    p2Lb := bar_index - pivotLen
    if not na(p1L) and not na(p2L) and not na(p1Lb) and p2Lb - p1Lb >= 8 and p2Lb - p1Lb <= 60 and math.abs(p2L - p1L) <= 0.35 * atr
        neckL := ta.highest(high, math.min(60, math.max(1, bar_index - p1Lb)))
        extL := math.min(p1L, p2L)
if useDouble and not na(ph)
    p1H := p2H
    p1Hb := p2Hb
    p2H := ph
    p2Hb := bar_index - pivotLen
    if not na(p1H) and not na(p2H) and not na(p1Hb) and p2Hb - p1Hb >= 8 and p2Hb - p1Hb <= 60 and math.abs(p2H - p1H) <= 0.35 * atr
        neckH := ta.lowest(low, math.min(60, math.max(1, bar_index - p1Hb)))
        extH := math.max(p1H, p2H)
dblUp = useDouble and not na(neckL) and not na(extL) and close > neckL and close[1] <= neckL and neckL - extL >= atr
dblDn = useDouble and not na(neckH) and not na(extH) and close < neckH and close[1] >= neckH and extH - neckH >= atr
if dblUp
    vLong += 1
    whyL += "• двойное дно\n"
    stopL := na(stopL) ? extL - pad : math.min(stopL, extL - pad)
    if drawL == 0
        drawL := 16
        drawY1L := extL
        drawY2L := neckL
if dblDn
    vShort += 1
    whyS += "• двойная вершина\n"
    stopS := na(stopS) ? extH + pad : math.max(stopS, extH + pad)
    if drawS == 0
        drawS := 16
        drawY1S := neckH
        drawY2S := extH

// 17) Sweep карты + ретест
var float mapSweepLvl = na
var int mapSweepSide = 0
var int mapSweepBar = na
mapSwUp = useSwRet and high > sh1 and close < sh1 and close < open
mapSwDn = useSwRet and low < sl1 and close > sl1 and close > open
if mapSwUp
    mapSweepLvl := sh1
    mapSweepSide := -1
    mapSweepBar := bar_index
if mapSwDn
    mapSweepLvl := sl1
    mapSweepSide := 1
    mapSweepBar := bar_index
swRetLong = useSwRet and mapSweepSide == 1 and not na(mapSweepLvl) and not na(mapSweepBar) and bar_index > mapSweepBar and bar_index - mapSweepBar <= 12 and low <= mapSweepLvl and close > mapSweepLvl and close > open
swRetShort = useSwRet and mapSweepSide == -1 and not na(mapSweepLvl) and not na(mapSweepBar) and bar_index > mapSweepBar and bar_index - mapSweepBar <= 12 and high >= mapSweepLvl and close < mapSweepLvl and close < open
if swRetLong
    vLong += 1
    whyL += "• sweep-ретест ↑\n"
    stopL := na(stopL) ? mapSweepLvl - pad : math.min(stopL, mapSweepLvl - pad)
    if drawL == 0
        drawL := 17
        drawY1L := mapSweepLvl
        drawY2L := mapSweepLvl
if swRetShort
    vShort += 1
    whyS += "• sweep-ретест ↓\n"
    stopS := na(stopS) ? mapSweepLvl + pad : math.max(stopS, mapSweepLvl + pad)
    if drawS == 0
        drawS := 17
        drawY1S := mapSweepLvl
        drawY2S := mapSweepLvl

// ── конфлюенс ──────────────────────────────────────────────────────────
rawLong = vLong >= minVotes and vLong > vShort and htfLong and not na(stopL) and close > stopL
rawShort = vShort >= minVotes and vShort > vLong and htfShort and not na(stopS) and close < stopS

var int lastFire = na
canFire = na(lastFire) or (bar_index - lastFire) >= cooldown

float entry = na
float stop = na
float take1 = na
float take2 = na
float take3 = na
int side = 0
string why = ""
int votes = 0

// снимок ВСЕХ причин для рисунка (не только первой)
var array<float> whyTopA = array.new_float()
var array<float> whyBotA = array.new_float()
var array<string> whyNameA = array.new_string()
var array<int> whyLeftA = array.new_int()
var array<int> whyKindA = array.new_int()  // 0=box 1=level 2=tl

clearWhy() =>
    array.clear(whyTopA)
    array.clear(whyBotA)
    array.clear(whyNameA)
    array.clear(whyLeftA)
    array.clear(whyKindA)

pushWhy(float top, float bot, string nm, int leftBars, int kind) =>
    array.push(whyTopA, top)
    array.push(whyBotA, bot)
    array.push(whyNameA, nm)
    array.push(whyLeftA, leftBars)
    array.push(whyKindA, kind)

snapWhy(int sdir) =>
    clearWhy()
    if sdir == 1
        if sweepLong
            pushWhy(priorLo, priorLo, "свип лоу", 8, 1)
        if brakeBot
            pushWhy(high, low, "тормоз", 1, 0)
        if tapeLong
            pushWhy(high, low, "Speed", 1, 0)
        if drLong
            pushWhy(math.min(open, close), low, "DR тень", 1, 0)
        if tlLong and not na(h2) and not na(tlDn)
            pushWhy(h2, tlDn, "↓тренд", math.max(1, bar_index - nz(hb2, bar_index)), 2)
        if defLong or brkLong
            pushWhy(zTop, zBot, defLong ? "защита зоны" : "пробой зоны", 10, 0)
        if obRetLong
            pushWhy(obTop, obBot, "ОБ↑", 8, 0)
        if ibUp
            pushWhy(motherHigh, motherLow, "инсайд", 2, 0)
        if fibLongSig
            pushWhy(skZoneTop, skZoneBot, "SK Fib", 12, 0)
        if bosRetLong
            pushWhy(pendLvl, pendLvl, "BOS/CHoCH", 8, 1)
        if fvgLong
            pushWhy(fvgTop, fvgBot, "FVG", 10, 0)
        if z146Long
            pushWhy(zLvl, zLvl, "Z146", 8, 1)
        if emaLong
            pushWhy(emaF, emaF, "EMA", 6, 1)
        if asiaLong
            pushWhy(asiaHi, asiaLo, "Asia", 16, 0)
        if sqUp
            pushWhy(sqHigh[1], sqLow[1], "сжатие", sqBars, 0)
        if dblUp
            pushWhy(neckL, extL, "двойное дно", 12, 0)
        if swRetLong
            pushWhy(mapSweepLvl, mapSweepLvl, "sweep-ретест", 8, 1)
    else
        if sweepShort
            pushWhy(priorHi, priorHi, "свип хая", 8, 1)
        if brakeTop
            pushWhy(high, low, "тормоз", 1, 0)
        if tapeShort
            pushWhy(high, low, "Speed", 1, 0)
        if drShort
            pushWhy(high, math.max(open, close), "DR тень", 1, 0)
        if tlShort and not na(l2) and not na(tlUp)
            pushWhy(l2, tlUp, "↑тренд", math.max(1, bar_index - nz(lb2, bar_index)), 2)
        if defShort or brkShort
            pushWhy(zTop, zBot, defShort ? "защита зоны" : "пробой зоны", 10, 0)
        if obRetShort
            pushWhy(obTop, obBot, "ОБ↓", 8, 0)
        if ibDn
            pushWhy(motherHigh, motherLow, "инсайд", 2, 0)
        if fibShortSig
            pushWhy(skZoneTop, skZoneBot, "SK Fib", 12, 0)
        if bosRetShort
            pushWhy(pendLvl, pendLvl, "BOS/CHoCH", 8, 1)
        if fvgShort
            pushWhy(fvgTop, fvgBot, "FVG", 10, 0)
        if z146Short
            pushWhy(zLvl, zLvl, "Z146", 8, 1)
        if emaShort
            pushWhy(emaF, emaF, "EMA", 6, 1)
        if asiaShort
            pushWhy(asiaHi, asiaLo, "Asia", 16, 0)
        if sqDn
            pushWhy(sqHigh[1], sqLow[1], "сжатие", sqBars, 0)
        if dblDn
            pushWhy(extH, neckH, "двойная вершина", 12, 0)
        if swRetShort
            pushWhy(mapSweepLvl, mapSweepLvl, "sweep-ретест", 8, 1)

if barstate.isconfirmed and canFire and rawLong
    entry := close
    stop := stopL
    risk = entry - stop
    if risk > 0
        take1 := entry + tp1R * risk
        take2 := entry + tp2R * risk
        take3 := entry + tp3R * risk
        side := 1
        why := whyL
        votes := vLong
        lastFire := bar_index
        snapWhy(1)

if barstate.isconfirmed and canFire and rawShort and side == 0
    entry := close
    stop := stopS
    risk = stop - entry
    if risk > 0
        take1 := entry - tp1R * risk
        take2 := entry - tp2R * risk
        take3 := entry - tp3R * risk
        side := -1
        why := whyS
        votes := vShort
        lastFire := bar_index
        snapWhy(-1)

var float eMem = na
var float sMem = na
var float t1Mem = na
var float t2Mem = na
var float t3Mem = na
var int sideMem = 0
var string whyMem = ""
var int votesMem = 0
var int bornMem = na

if side != 0
    eMem := entry
    sMem := stop
    t1Mem := take1
    t2Mem := take2
    t3Mem := take3
    sideMem := side
    whyMem := why
    votesMem := votes
    bornMem := bar_index

haveSig = not na(eMem) and not na(bornMem) and (bar_index - bornMem) <= freshBars
if haveSig
    entry := eMem
    stop := sMem
    take1 := t1Mem
    take2 := t2Mem
    take3 := t3Mem
    side := sideMem
    why := whyMem
    votes := votesMem
else
    eMem := na
    sMem := na
    t1Mem := na
    t2Mem := na
    t3Mem := na
    sideMem := 0
    whyMem := ""
    votesMem := 0
    bornMem := na
    entry := na
    stop := na
    take1 := na
    take2 := na
    take3 := na
    side := 0
    why := ""
    votes := 0
    if array.size(whyTopA) > 0
        clearWhy()

float take = take2  // основной тейк для истории / алертов = TP2

nearEntry = haveSig and math.abs(close - entry) <= liveAtr * atr
late = haveSig and not nearEntry and (side == 1 ? close > entry : close < entry)
status = not haveSig ? "WAIT" : nearEntry ? "NOW" : late ? "LATE" : "WAIT_FILL"

// ── история только конфлюенс-сигналов ──────────────────────────────────
var array<int> exBi = array.new_int()
var array<int> exSide = array.new_int()
var array<float> exE = array.new_float()
var array<float> exS = array.new_float()
var array<float> exT = array.new_float()
var array<int> exOut = array.new_int()
var array<int> exAge = array.new_int()

if barstate.isconfirmed and haveSig and not na(bornMem) and bar_index == bornMem and side != 0
    array.push(exBi, bar_index)
    array.push(exSide, side)
    array.push(exE, entry)
    array.push(exS, stop)
    array.push(exT, take)
    array.push(exOut, 0)
    array.push(exAge, 0)
    while array.size(exBi) > 8
        array.shift(exBi)
        array.shift(exSide)
        array.shift(exE)
        array.shift(exS)
        array.shift(exT)
        array.shift(exOut)
        array.shift(exAge)

if showHist and array.size(exBi) > 0
    for i = 0 to array.size(exBi) - 1
        if array.get(exOut, i) == 0 and bar_index > array.get(exBi, i)
            age = array.get(exAge, i) + 1
            array.set(exAge, i, age)
            sSide = array.get(exSide, i)
            s0 = array.get(exS, i)
            t0 = array.get(exT, i)
            if sSide == 1
                if low <= s0
                    array.set(exOut, i, -1)
                else if high >= t0
                    array.set(exOut, i, 1)
            else
                if high >= s0
                    array.set(exOut, i, -1)
                else if low <= t0
                    array.set(exOut, i, 1)
            if array.get(exOut, i) == 0 and age >= 24
                array.set(exOut, i, 2)

plotshape(showHist and haveSig and bar_index == bornMem and side == 1, title = "L", style = shape.triangleup, location = location.belowbar, color = colGo, size = size.tiny)
plotshape(showHist and haveSig and bar_index == bornMem and side == -1, title = "S", style = shape.triangledown, location = location.abovebar, color = colStop, size = size.tiny)

// ── рисунок ТОЛЬКО активного сигнала: позиция + каждый тейк ────────────
var label lbMain = na
var label lbWhy = na
var label lbE = na
var label lbS = na
var label lbT1 = na
var label lbT2 = na
var label lbT3 = na
var label lbPos = na
var line lnE = na
var line lnS = na
var line lnT1 = na
var line lnT2 = na
var line lnT3 = na
var line lnPath = na
var box bxRisk = na
var box bxTp1 = na
var box bxTp2 = na
var box bxTp3 = na
var array<label> histLabs = array.new_label()
var array<box> whyBoxes = array.new_box()
var array<line> whyLines = array.new_line()
var array<label> whyLabs = array.new_label()

if barstate.islast
    label.delete(lbMain)
    label.delete(lbWhy)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lbT1)
    label.delete(lbT2)
    label.delete(lbT3)
    label.delete(lbPos)
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT1)
    line.delete(lnT2)
    line.delete(lnT3)
    line.delete(lnPath)
    box.delete(bxRisk)
    box.delete(bxTp1)
    box.delete(bxTp2)
    box.delete(bxTp3)
    if array.size(histLabs) > 0
        for k = 0 to array.size(histLabs) - 1
            label.delete(array.get(histLabs, k))
        array.clear(histLabs)
    if array.size(whyBoxes) > 0
        for k = 0 to array.size(whyBoxes) - 1
            box.delete(array.get(whyBoxes, k))
        array.clear(whyBoxes)
    if array.size(whyLines) > 0
        for k = 0 to array.size(whyLines) - 1
            line.delete(array.get(whyLines, k))
        array.clear(whyLines)
    if array.size(whyLabs) > 0
        for k = 0 to array.size(whyLabs) - 1
            label.delete(array.get(whyLabs, k))
        array.clear(whyLabs)

    x2 = bar_index + 10
    if status == "WAIT"
        bgVotes = "фон: L" + str.tostring(vLong) + " / S" + str.tostring(vShort) + " (нужно ≥" + str.tostring(minVotes) + ")"
        lbMain := label.new(x2, close, "ЖДИ\nсигнала нет\n\n" + bgVotes, style = label.style_label_left, color = color.new(colWait, 0), textcolor = color.white, size = size.normal)
    else if status == "LATE"
        lbMain := label.new(x2, close, "ОПОЗДАЛ\nне догоняй", style = label.style_label_left, color = color.new(colLate, 0), textcolor = color.white, size = size.large)
    else
        sideTxt = side == 1 ? (status == "NOW" ? "ЛОНГ СЕЙЧАС" : "ЛОНГ · жди цену") : (status == "NOW" ? "ШОРТ СЕЙЧАС" : "ШОРТ · жди цену")
        col = side == 1 ? colGo : colStop
        risk = math.abs(entry - stop)
        pct1 = pxPct(entry, take1)
        pct2 = pxPct(entry, take2)
        pct3 = pxPct(entry, take3)
        marg2 = pct2 * leverage
        wait1 = fmtWait(etaMinutes(entry, take1))
        wait2 = fmtWait(etaMinutes(entry, take2))
        wait3 = fmtWait(etaMinutes(entry, take3))
        waitSl = fmtWait(etaMinutes(entry, stop))
        b0 = nz(bornMem, bar_index)
        // полосы позиции: риск + каждый тейк отдельно (+ время)
        bxRisk := box.new(b0, math.max(entry, stop), x2, math.min(entry, stop), bgcolor = color.new(colStop, 88), border_color = color.new(colStop, 40), border_width = 1, text = "РИСК · " + waitSl, text_color = colStop, text_size = size.tiny)
        if side == 1
            bxTp1 := box.new(b0, take1, x2, entry, bgcolor = color.new(colGo, 92), border_color = color.new(colGo, 50), border_width = 1, text = "TP1 " + str.tostring(tp1R, "#.#") + "R · " + wait1, text_color = colGo, text_size = size.tiny)
            bxTp2 := box.new(b0, take2, x2, take1, bgcolor = color.new(colTp, 90), border_color = color.new(colTp, 40), border_width = 1, text = "TP2 " + str.tostring(tp2R, "#.#") + "R · " + wait2, text_color = colTp, text_size = size.tiny)
            bxTp3 := box.new(b0, take3, x2, take2, bgcolor = color.new(#8B5CF6, 90), border_color = color.new(#8B5CF6, 40), border_width = 1, text = "TP3 " + str.tostring(tp3R, "#.#") + "R · " + wait3, text_color = #A78BFA, text_size = size.tiny)
        else
            bxTp1 := box.new(b0, entry, x2, take1, bgcolor = color.new(colGo, 92), border_color = color.new(colGo, 50), border_width = 1, text = "TP1 " + str.tostring(tp1R, "#.#") + "R · " + wait1, text_color = colGo, text_size = size.tiny)
            bxTp2 := box.new(b0, take1, x2, take2, bgcolor = color.new(colTp, 90), border_color = color.new(colTp, 40), border_width = 1, text = "TP2 " + str.tostring(tp2R, "#.#") + "R · " + wait2, text_color = colTp, text_size = size.tiny)
            bxTp3 := box.new(b0, take2, x2, take3, bgcolor = color.new(#8B5CF6, 90), border_color = color.new(#8B5CF6, 40), border_width = 1, text = "TP3 " + str.tostring(tp3R, "#.#") + "R · " + wait3, text_color = #A78BFA, text_size = size.tiny)

        lbMain := label.new(x2, entry, sideTxt + "\nсовпадений: " + str.tostring(votes) + "\nTP2 +" + str.tostring(pct2, "#.##") + "% · " + str.tostring(tp2R, "#.#") + "R · маржа~" + str.tostring(marg2, "#.#") + "%\nждать TP1 " + wait1 + " · TP2 " + wait2 + " · TP3 " + wait3, style = label.style_label_left, color = color.new(col, 0), textcolor = color.white, size = size.large)
        midPos = (entry + take2) / 2.0
        lbPos := label.new(b0, midPos, "ПОЗИЦИЯ\nстоп → TP1 → TP2 → TP3\nждать ≈ " + wait1 + " / " + wait2 + " / " + wait3, style = label.style_label_left, color = color.new(#1E2329, 10), textcolor = color.white, size = size.small)
        // текст ПОЧЕМУ у первой нарисованной причины (или у входа)
        whyY = take3
        lbWhy := label.new(math.max(0, b0 - 2), whyY, "ПОЧЕМУ:\n" + why, style = label.style_label_right, color = color.new(#1E2329, 0), textcolor = color.white, size = size.normal)

        lnE := line.new(b0, entry, x2, entry, color = colGo, width = 4)
        lnS := line.new(b0, stop, x2, stop, color = colStop, width = 3, style = line.style_dotted)
        lnT1 := line.new(b0, take1, x2, take1, color = colGo, width = 2, style = line.style_dashed)
        lnT2 := line.new(b0, take2, x2, take2, color = colTp, width = 3, style = line.style_dashed)
        lnT3 := line.new(b0, take3, x2, take3, color = #8B5CF6, width = 2, style = line.style_dashed)
        lnPath := line.new(b0, entry, x2, take3, color = color.new(col, 30), width = 2)

        lbE := label.new(x2, entry, "1 ВХОД " + str.tostring(entry, format.mintick) + "\nсейчас", style = label.style_label_left, color = colGo, textcolor = color.white, size = size.normal)
        lbS := label.new(x2, stop, "2 СТОП " + str.tostring(stop, format.mintick) + " (−" + str.tostring(pxPct(entry, stop), "#.##") + "%)\nесли против ≈ " + waitSl, style = label.style_label_left, color = colStop, textcolor = color.white, size = size.normal)
        lbT1 := label.new(x2, take1, "3 ТЕЙК1 " + str.tostring(take1, format.mintick) + "\n+" + str.tostring(pct1, "#.##") + "% · " + str.tostring(tp1R, "#.#") + "R · ждать " + wait1, style = label.style_label_left, color = colGo, textcolor = color.white, size = size.normal)
        lbT2 := label.new(x2, take2, "4 ТЕЙК2 " + str.tostring(take2, format.mintick) + "\n+" + str.tostring(pct2, "#.##") + "% · " + str.tostring(tp2R, "#.#") + "R · ждать " + wait2, style = label.style_label_left, color = colTp, textcolor = color.white, size = size.normal)
        lbT3 := label.new(x2, take3, "5 ТЕЙК3 " + str.tostring(take3, format.mintick) + "\n+" + str.tostring(pct3, "#.##") + "% · " + str.tostring(tp3R, "#.#") + "R · ждать " + wait3, style = label.style_label_left, color = #8B5CF6, textcolor = color.white, size = size.normal)

        // РИСУЕМ КАЖДУЮ причину из ПОЧЕМУ (не только первую)
        if array.size(whyTopA) > 0
            for wi = 0 to array.size(whyTopA) - 1
                wTop = array.get(whyTopA, wi)
                wBot = array.get(whyBotA, wi)
                wName = array.get(whyNameA, wi)
                wLeft = array.get(whyLeftA, wi)
                wKind = array.get(whyKindA, wi)
                xL = math.max(b0 - wLeft, b0 - 40)
                if wKind == 2
                    array.push(whyLines, line.new(xL, wTop, b0, wBot, color = color.new(colTp, 10), width = 3))
                    array.push(whyLabs, label.new(xL, wTop, wName, style = label.style_label_right, color = color.new(colWhy, 10), textcolor = color.black, size = size.small))
                else if wKind == 1 or math.abs(wTop - wBot) <= syminfo.mintick * 2
                    array.push(whyLines, line.new(xL, wTop, b0 + 2, wTop, color = color.new(colWhy, 0), width = 2, style = line.style_dashed))
                    array.push(whyLabs, label.new(xL, wTop, wName, style = label.style_label_right, color = color.new(colWhy, 5), textcolor = color.black, size = size.small))
                else
                    colBx = wName == "SK Fib" ? #8B5CF6 : wName == "сжатие" or str.contains(wName, "зона") ? colWhy : wName == "Asia" ? #00BCD4 : colWhy
                    array.push(whyBoxes, box.new(xL, math.max(wTop, wBot), b0 + 1, math.min(wTop, wBot), bgcolor = color.new(colBx, 82), border_color = colBx, border_width = 2, text = wName, text_color = color.black, text_size = size.small))
                    array.push(whyLabs, label.new(xL, math.max(wTop, wBot), "← " + wName, style = label.style_label_down, color = color.new(colBx, 15), textcolor = color.white, size = size.small))

    // последние 3 конфлюенс-итога компактно
    if showHist and array.size(exBi) > 0
        fromIdx = math.max(0, array.size(exBi) - 3)
        for i = fromIdx to array.size(exBi) - 1
            bi = array.get(exBi, i)
            if bi != bornMem or status == "WAIT"
                sSide = array.get(exSide, i)
                e0 = array.get(exE, i)
                t0 = array.get(exT, i)
                outc = array.get(exOut, i)
                res = outc == 1 ? "ТЕЙК✓" : outc == -1 ? "СТОП✗" : outc == 2 ? "мимо" : "…"
                array.push(histLabs, label.new(bi, e0, (sSide == 1 ? "L " : "S ") + res + "\nтейк " + str.tostring(t0, format.mintick), style = sSide == 1 ? label.style_label_up : label.style_label_down, color = color.new(outc == 1 ? colGo : outc == -1 ? colStop : colMiss, 20), textcolor = color.white, size = size.tiny))

var table t = table.new(position.top_right, 1, 5, bgcolor = color.new(#0B0E11, 0), border_width = 1, border_color = #2B3139)
if barstate.islast
    big = status == "NOW" ? (side == 1 ? "ЛОНГ СЕЙЧАС" : "ШОРТ СЕЙЧАС") : status == "LATE" ? "ОПОЗДАЛ" : status == "WAIT_FILL" ? "жди цену" : "ЖДИ"
    table.cell(t, 0, 0, big, text_color = status == "NOW" ? colGo : status == "LATE" ? colLate : colNow, text_size = size.large)
    table.cell(t, 0, 1, haveSig ? ("вход " + str.tostring(entry, format.mintick) + " · стоп " + str.tostring(stop, format.mintick)) : ("микс · нужно ≥" + str.tostring(minVotes) + " · L" + str.tostring(vLong) + "/S" + str.tostring(vShort)), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, haveSig ? ("ТЕЙК1 +" + str.tostring(pxPct(entry, take1), "#.##") + "% · ждать " + fmtWait(etaMinutes(entry, take1))) : "—", text_color = colGo, text_size = size.small)
    table.cell(t, 0, 3, haveSig ? ("ТЕЙК2 +" + str.tostring(pxPct(entry, take2), "#.##") + "% · ждать " + fmtWait(etaMinutes(entry, take2))) : "—", text_color = colTp, text_size = size.small)
    table.cell(t, 0, 4, haveSig ? ("ТЕЙК3 +" + str.tostring(pxPct(entry, take3), "#.##") + "% · ждать " + fmtWait(etaMinutes(entry, take3))) : "оценка времени ≈ по ATR/ТФ", text_color = #A78BFA, text_size = size.small)

fireLong = haveSig and bar_index == bornMem and side == 1
fireShort = haveSig and bar_index == bornMem and side == -1
goLong = status == "NOW" and side == 1 and not (status[1] == "NOW" and side[1] == 1)
goShort = status == "NOW" and side == -1 and not (status[1] == "NOW" and side[1] == -1)

if barstate.isconfirmed
    if fireLong
        alert("MIX ЛОНГ · " + syminfo.ticker + " · вход " + str.tostring(entry, format.mintick) + " · стоп " + str.tostring(stop, format.mintick) + " · TP1 " + str.tostring(take1, format.mintick) + " · TP2 " + str.tostring(take2, format.mintick) + " · TP3 " + str.tostring(take3, format.mintick) + "\n" + why, alert.freq_once_per_bar_close)
    if fireShort
        alert("MIX ШОРТ · " + syminfo.ticker + " · вход " + str.tostring(entry, format.mintick) + " · стоп " + str.tostring(stop, format.mintick) + " · TP1 " + str.tostring(take1, format.mintick) + " · TP2 " + str.tostring(take2, format.mintick) + " · TP3 " + str.tostring(take3, format.mintick) + "\n" + why, alert.freq_once_per_bar_close)
    if goLong and not fireLong
        alert("ЛОНГ СЕЙЧАС · " + syminfo.ticker, alert.freq_once_per_bar_close)
    if goShort and not fireShort
        alert("ШОРТ СЕЙЧАС · " + syminfo.ticker, alert.freq_once_per_bar_close)

alertcondition(fireLong, title = "Mix лонг", message = "65 Signal Mix ЛОНГ")
alertcondition(fireShort, title = "Mix шорт", message = "65 Signal Mix ШОРТ")
alertcondition(goLong, title = "Лонг сейчас", message = "ЛОНГ СЕЙЧАС")
alertcondition(goShort, title = "Шорт сейчас", message = "ШОРТ СЕЙЧАС")
