//@version=6
// Pandich Matematik 2.6 — recreation from published logic (idea: wave / 2.6 projection).
// Last confirmed pivot high/low → offset = range/2.6 → BUY below low / SELL above high.
// Entry at target, stop = 35% of offset beyond, TP1 = opposite pivot, TP2 = mid range.
indicator("Matematik 2.6 [pandich]", shorttitle = "M26 [pandich]", overlay = true, max_labels_count = 100, max_lines_count = 80, max_boxes_count = 40)

grp = "Wave"
divN    = input.float(2.6, "Делитель диапазона", minval = 1.1, step = 0.1, group = grp)
pivL    = input.int(5, "Pivot: баров слева", minval = 1, group = grp)
pivR    = input.int(3, "Pivot: баров справа", minval = 1, group = grp)
minRange = input.float(1.0, "Мин. диапазон волны, в цене", minval = 0.0, step = 0.1, group = grp)
entryMode = input.string("Zone touch", "Режим входа", options = ["Zone touch", "Candle close"], group = grp)
zonePct = input.float(15.0, "Zone thickness % of offset", minval = 1, maxval = 100, group = grp)

grpR = "Risk"
stopPct = input.float(35.0, "Stop % of offset", minval = 5, maxval = 200, group = grpR)
tp1Share = input.float(50.0, "Close at TP1 %", minval = 0, maxval = 100, group = grpR)
useBE   = input.bool(true, "BE after TP1", group = grpR)
cost    = input.float(0.30, "Cost / RT", minval = 0.0, step = 0.01, group = grpR)
window  = input.int(20, "Trade window bars", minval = 3, maxval = 200, group = grpR)

ph = ta.pivothigh(high, pivL, pivR)
pl = ta.pivotlow(low, pivL, pivR)

var float pivHi = na
var float pivLo = na
var int hiBar = na
var int loBar = na
var int waitDir = 0 // 1 wait BUY zone, -1 wait SELL zone

if not na(ph)
    pivHi := ph
    hiBar := bar_index - pivR
    waitDir := 1
if not na(pl)
    pivLo := pl
    loBar := bar_index - pivR
    waitDir := -1

float waveRange = na
float offset = na
float buyLvl = na
float sellLvl = na
float zoneHalf = na
if not na(pivHi) and not na(pivLo)
    waveRange := math.abs(pivHi - pivLo)
    if waveRange >= minRange
        offset := waveRange / divN
        zoneHalf := offset * zonePct / 100.0
        buyLvl := pivLo - offset
        sellLvl := pivHi + offset

touchBuy = waitDir == 1 and not na(buyLvl) and low <= buyLvl + zoneHalf and low >= buyLvl - zoneHalf
touchSell = waitDir == -1 and not na(sellLvl) and high >= sellLvl - zoneHalf and high <= sellLvl + zoneHalf
closeBuy = waitDir == 1 and not na(buyLvl) and low < buyLvl and close > buyLvl
closeSell = waitDir == -1 and not na(sellLvl) and high > sellLvl and close < sellLvl
fireL = entryMode == "Zone touch" ? touchBuy : closeBuy
fireS = entryMode == "Zone touch" ? touchSell : closeSell

var int tradeDir = 0
var float tEntry = na
var float tStop = na
var float tTp1 = na
var float tTp2 = na
var int tBar = na
var bool tp1Done = false

var int nTrades = 0
var int nWin = 0
var float sumR = 0.0

if tradeDir != 0 and bar_index > tBar
    risk = math.abs(tEntry - tStop)
    costR = risk > 0 ? cost / risk : 0.0
    curStop = tp1Done and useBE ? tEntry : tStop
    int outcome = 0
    float resR = na
    if tradeDir == 1
        if low <= curStop
            outcome := -1
            resR := tp1Done ? (tp1Share / 100.0) * ((tTp1 - tEntry) / risk - costR) : -1.0 - costR
        else if high >= tTp1 and not tp1Done
            tp1Done := true
            if tp1Share >= 100
                outcome := 1
                resR := (tTp1 - tEntry) / risk - costR
        else if high >= tTp2
            outcome := 2
            r1 = (tTp1 - tEntry) / risk
            r2 = (tTp2 - tEntry) / risk
            resR := tp1Done ? (tp1Share / 100.0) * (r1 - costR) + (1 - tp1Share / 100.0) * (r2 - costR) : r2 - costR
        else if bar_index - tBar >= window
            outcome := 3
            resR := (close - tEntry) / risk - costR
    else
        if high >= curStop
            outcome := -1
            resR := tp1Done ? (tp1Share / 100.0) * ((tEntry - tTp1) / risk - costR) : -1.0 - costR
        else if low <= tTp1 and not tp1Done
            tp1Done := true
            if tp1Share >= 100
                outcome := 1
                resR := (tEntry - tTp1) / risk - costR
        else if low <= tTp2
            outcome := 2
            r1 = (tEntry - tTp1) / risk
            r2 = (tEntry - tTp2) / risk
            resR := tp1Done ? (tp1Share / 100.0) * (r1 - costR) + (1 - tp1Share / 100.0) * (r2 - costR) : r2 - costR
        else if bar_index - tBar >= window
            outcome := 3
            resR := (tEntry - close) / risk - costR
    if outcome != 0
        nTrades += 1
        sumR += resR
        if resR > 0
            nWin += 1
        tradeDir := 0
        waitDir := 0

if fireL and tradeDir == 0 and not na(buyLvl) and not na(offset)
    tradeDir := 1
    tEntry := buyLvl
    tStop := buyLvl - offset * stopPct / 100.0
    tTp1 := pivLo
    tTp2 := pivLo + waveRange * 0.5
    tBar := bar_index
    tp1Done := false
    waitDir := 0
if fireS and tradeDir == 0 and not na(sellLvl) and not na(offset)
    tradeDir := -1
    tEntry := sellLvl
    tStop := sellLvl + offset * stopPct / 100.0
    tTp1 := pivHi
    tTp2 := pivHi - waveRange * 0.5
    tBar := bar_index
    tp1Done := false
    waitDir := 0

colL = #0ECB81
colS = #F6465D
plotshape(fireL and tradeDir == 1 and tBar == bar_index, "BUY 2.6", shape.labelup, location.belowbar, colL, text = "BUY 2.6", textcolor = color.white, size = size.tiny)
plotshape(fireS and tradeDir == -1 and tBar == bar_index, "SELL 2.6", shape.labeldown, location.abovebar, colS, text = "SELL 2.6", textcolor = color.white, size = size.tiny)

pBuy = plot(buyLvl, "BUY lvl", color = color.new(colL, 60), style = plot.style_linebr)
pSell = plot(sellLvl, "SELL lvl", color = color.new(colS, 60), style = plot.style_linebr)

var table t = table.new(position.top_right, 2, 5, bgcolor = color.new(#0B0E11, 5), border_width = 1, border_color = #2B3139)
avgR = nTrades > 0 ? sumR / nTrades : na
if barstate.islast
    table.cell(t, 0, 0, "M26", text_color = color.yellow, text_size = size.small)
    table.cell(t, 1, 0, tradeDir == 0 ? (waitDir == 1 ? "wait BUY zone" : waitDir == -1 ? "wait SELL zone" : "—") : (tradeDir == 1 ? "LONG" : "SHORT"), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 1, "Trades", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 1, str.tostring(nTrades), text_color = nTrades >= 100 ? color.white : color.gray, text_size = size.tiny)
    table.cell(t, 0, 2, "Win%", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 2, nTrades > 0 ? str.tostring(nWin * 100.0 / nTrades, "#.#") + "%" : "—", text_color = color.white, text_size = size.tiny)
    table.cell(t, 0, 3, "Avg R", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 3, na(avgR) ? "—" : str.tostring(avgR, "#.##") + "R", text_color = na(avgR) ? color.gray : avgR > 0 ? colL : colS, text_size = size.tiny)
    table.cell(t, 0, 4, "Range/off", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 4, na(waveRange) ? "—" : str.tostring(waveRange, format.mintick) + " / " + str.tostring(offset, format.mintick), text_color = color.white, text_size = size.tiny)

alertcondition(fireL and tradeDir == 1 and tBar == bar_index, "BUY 2.6", "Matematik BUY 2.6")
alertcondition(fireS and tradeDir == -1 and tBar == bar_index, "SELL 2.6", "Matematik SELL 2.6")
