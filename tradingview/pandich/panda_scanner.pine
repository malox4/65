//@version=6
// Pandich Panda Scanner — recreation: 6 setups → ATR×1.2 stop, 1/2/3R, 60-bar expiry, scoreboard per setup.
// Setups: VWAP reclaim · EMA pullback · Break+retest · Liquidity sweep · RSI divergence · Opening range break.
indicator("Pandich Panda Scanner [65]", overlay = true, max_labels_count = 100, max_lines_count = 80, max_boxes_count = 40, max_bars_back = 500)

grp = "Engine"
atrLen = input.int(14, "ATR", group = grp)
stopMult = input.float(1.2, "Stop × ATR", group = grp)
tp1R = input.float(1.0, "TP1 R", group = grp)
tp2R = input.float(2.0, "TP2 R", group = grp)
tp3R = input.float(3.0, "TP3 R", group = grp)
horizon = input.int(60, "Expiry bars", group = grp)
maxTrades = input.int(1, "Max concurrent", minval = 1, maxval = 6, group = grp)
blockOpp = input.bool(true, "Block opposite", group = grp)
cooldown = input.int(0, "Cooldown bars", group = grp)
volMult = input.float(1.0, "Volume filter × SMA (0=off)", group = grp)
showBlocked = input.bool(false, "Mark blocked signals", group = grp)

grpU = "Setups"
useVwap = input.bool(true, "1 VWAP reclaim", group = grpU)
useEma = input.bool(true, "2 EMA pullback", group = grpU)
useBos = input.bool(true, "3 Break and retest", group = grpU)
useSw = input.bool(true, "4 Liquidity sweep", group = grpU)
useDiv = input.bool(true, "5 RSI divergence", group = grpU)
useOrb = input.bool(true, "6 Opening range", group = grpU)
vwapRun = input.int(6, "VWAP run bars", group = grpU)
emaTouch = input.int(3, "EMA touch lookback", group = grpU)
retestWin = input.int(20, "Retest window", group = grpU)
orbMin = input.int(15, "ORB minutes", group = grpU)
orbSess = input.session("0930-1600", "ORB session", group = grpU)

atr = ta.atr(atrLen)
volSma = ta.sma(volume, 20)
volOk = volMult <= 0 or volume > volSma * volMult
vwap = ta.vwap
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
rsi = ta.rsi(close, 14)

// 1 VWAP reclaim
var int sideRun = 0
above = close > vwap
sideRun := above == above[1] ? sideRun + 1 : 1
vwapLong = useVwap and volOk and sideRun[1] >= vwapRun and close[1] < vwap[1] and close > vwap
vwapShort = useVwap and volOk and sideRun[1] >= vwapRun and close[1] > vwap[1] and close < vwap

// 2 EMA pullback
emaTrendUp = ema21 > ema50 and ema50 > ema50[3]
emaTrendDn = ema21 < ema50 and ema50 < ema50[3]
touched21Up = ta.lowest(low, emaTouch) <= ema21
touched21Dn = ta.highest(high, emaTouch) >= ema21
emaLong = useEma and volOk and emaTrendUp and touched21Up and close > ema9 and close > high[1]
emaShort = useEma and volOk and emaTrendDn and touched21Dn and close < ema9 and close < low[1]

// 3 Break and retest
pivLen = 5
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var float brkLvl = na
var int brkDir = 0
var int brkBar = na
var float lvlH = na
var float lvlL = na
if not na(ph)
    lvlH := ph
if not na(pl)
    lvlL := pl
if not na(lvlH) and close > lvlH and close[1] <= lvlH
    brkLvl := lvlH
    brkDir := 1
    brkBar := bar_index
if not na(lvlL) and close < lvlL and close[1] >= lvlL
    brkLvl := lvlL
    brkDir := -1
    brkBar := bar_index
bosLong = useBos and brkDir == 1 and not na(brkBar) and bar_index > brkBar and bar_index - brkBar <= retestWin and low <= brkLvl + 0.3 * atr and close > brkLvl and close > open
bosShort = useBos and brkDir == -1 and not na(brkBar) and bar_index > brkBar and bar_index - brkBar <= retestWin and high >= brkLvl - 0.3 * atr and close < brkLvl and close < open

// 4 Sweep
priorHi = ta.highest(high[1], 20)
priorLo = ta.lowest(low[1], 20)
upW = high - math.max(open, close)
loW = math.min(open, close) - low
swLong = useSw and volOk and low < priorLo and close > priorLo and loW > upW
swShort = useSw and volOk and high > priorHi and close < priorHi and upW > loW

// 5 RSI divergence (late by design)
rsiPh = ta.pivothigh(rsi, pivLen, pivLen)
rsiPl = ta.pivotlow(rsi, pivLen, pivLen)
var float pLo1 = na
var float pLo2 = na
var float rLo1 = na
var float rLo2 = na
var float pHi1 = na
var float pHi2 = na
var float rHi1 = na
var float rHi2 = na
var int pLoBar1 = na
var int pHiBar1 = na
if not na(pl)
    pLo2 := pLo1
    rLo2 := rLo1
    pLo1 := pl
    rLo1 := rsi[pivLen]
    pLoBar1 := bar_index - pivLen
if not na(ph)
    pHi2 := pHi1
    rHi2 := rHi1
    pHi1 := ph
    rHi1 := rsi[pivLen]
    pHiBar1 := bar_index - pivLen
divLong = useDiv and not na(pLo1) and not na(pLo2) and pLo1 < pLo2 and rLo1 > rLo2 and not na(pLoBar1) and bar_index - pLoBar1 <= 60 and bar_index - pLoBar1 == pivLen
divShort = useDiv and not na(pHi1) and not na(pHi2) and pHi1 > pHi2 and rHi1 < rHi2 and not na(pHiBar1) and bar_index - pHiBar1 <= 60 and bar_index - pHiBar1 == pivLen

// 6 ORB
inOrbBuild = not na(time(timeframe.period, orbSess))
var float orbHi = na
var float orbLo = na
var int orbStart = na
var bool orbReady = false
var bool orbUsed = false
if inOrbBuild and (na(orbStart) or not inOrbBuild[1])
    orbStart := bar_index
    orbHi := high
    orbLo := low
    orbReady := false
    orbUsed := false
if inOrbBuild and not na(orbStart) and not orbReady
    orbHi := math.max(orbHi, high)
    orbLo := math.min(orbLo, low)
    // approximate minutes via bars * tf minutes
    barsNeed = math.max(1, int(math.round(orbMin / math.max(timeframe.in_seconds() / 60.0, 1.0))))
    if bar_index - orbStart + 1 >= barsNeed
        orbReady := true
orbLong = useOrb and orbReady and not orbUsed and close > orbHi
orbShort = useOrb and orbReady and not orbUsed and close < orbLo
if orbLong or orbShort
    orbUsed := true

// Priority order: VWAP, EMA, BOS, Sweep, Div, ORB
string setupName = ""
int rawDir = 0
if vwapLong
    setupName := "VWAP"
    rawDir := 1
else if vwapShort
    setupName := "VWAP"
    rawDir := -1
else if emaLong
    setupName := "EMA"
    rawDir := 1
else if emaShort
    setupName := "EMA"
    rawDir := -1
else if bosLong
    setupName := "BOS"
    rawDir := 1
else if bosShort
    setupName := "BOS"
    rawDir := -1
else if swLong
    setupName := "SWEEP"
    rawDir := 1
else if swShort
    setupName := "SWEEP"
    rawDir := -1
else if divLong
    setupName := "DIV"
    rawDir := 1
else if divShort
    setupName := "DIV"
    rawDir := -1
else if orbLong
    setupName := "ORB"
    rawDir := 1
else if orbShort
    setupName := "ORB"
    rawDir := -1

var int tradeDir = 0
var float tEntry = na
var float tStop = na
var float tTp1 = na
var float tTp2 = na
var float tTp3 = na
var int tBar = na
var string tSetup = ""
var int lastClose = na
var int openCount = 0

var int nV=0
var int nE=0
var int nB=0
var int nS=0
var int nD=0
var int nO=0
var int tV=0
var int tE=0
var int tB=0
var int tS=0
var int tD=0
var int tO=0

coolOk = na(lastClose) or bar_index - lastClose >= cooldown
canLong = tradeDir == 0 and coolOk and (not blockOpp or tradeDir != -1)
canShort = tradeDir == 0 and coolOk and (not blockOpp or tradeDir != 1)
fire = rawDir != 0 and ((rawDir == 1 and canLong) or (rawDir == -1 and canShort)) and openCount < maxTrades
blocked = rawDir != 0 and not fire

if tradeDir != 0 and bar_index > tBar
    int outcome = 0
    if tradeDir == 1
        if low <= tStop
            outcome := -1
        else if high >= tTp3
            outcome := 3
        else if bar_index - tBar >= horizon
            outcome := 2
    else
        if high >= tStop
            outcome := -1
        else if low <= tTp3
            outcome := 3
        else if bar_index - tBar >= horizon
            outcome := 2
    hitTp1 = tradeDir == 1 ? high >= tTp1 : low <= tTp1
    if outcome != 0
        if tSetup == "VWAP"
            nV += 1
            if hitTp1 or outcome == 3
                tV += 1
        else if tSetup == "EMA"
            nE += 1
            if hitTp1 or outcome == 3
                tE += 1
        else if tSetup == "BOS"
            nB += 1
            if hitTp1 or outcome == 3
                tB += 1
        else if tSetup == "SWEEP"
            nS += 1
            if hitTp1 or outcome == 3
                tS += 1
        else if tSetup == "DIV"
            nD += 1
            if hitTp1 or outcome == 3
                tD += 1
        else if tSetup == "ORB"
            nO += 1
            if hitTp1 or outcome == 3
                tO += 1
        tradeDir := 0
        openCount := 0
        lastClose := bar_index

if fire
    tradeDir := rawDir
    tEntry := close
    tSetup := setupName
    tBar := bar_index
    openCount := 1
    if rawDir == 1
        tStop := close - stopMult * atr
        risk = tEntry - tStop
        tTp1 := tEntry + tp1R * risk
        tTp2 := tEntry + tp2R * risk
        tTp3 := tEntry + tp3R * risk
    else
        tStop := close + stopMult * atr
        risk = tStop - tEntry
        tTp1 := tEntry - tp1R * risk
        tTp2 := tEntry - tp2R * risk
        tTp3 := tEntry - tp3R * risk

colL = #0ECB81
colS = #F6465D
plotshape(fire and rawDir == 1, "Long", shape.triangleup, location.belowbar, colL, size = size.tiny, text = setupName)
plotshape(fire and rawDir == -1, "Short", shape.triangledown, location.abovebar, colS, size = size.tiny, text = setupName)
plotshape(showBlocked and blocked, "Blocked", shape.xcross, location.top, color.gray, size = size.tiny)
plot(orbReady ? orbHi : na, "ORB hi", color = color.new(color.blue, 50), style = plot.style_linebr)
plot(orbReady ? orbLo : na, "ORB lo", color = color.new(color.blue, 50), style = plot.style_linebr)

pct(n, t) => n > 0 ? t * 100.0 / n : na
var table tab = table.new(position.bottom_right, 3, 8, bgcolor = color.new(#0B0E11, 5), border_width = 1, border_color = #2B3139)
if barstate.islast
    table.cell(tab, 0, 0, "Setup", text_color = color.yellow, text_size = size.tiny)
    table.cell(tab, 1, 0, "Fired", text_color = color.yellow, text_size = size.tiny)
    table.cell(tab, 2, 0, "→TP1", text_color = color.yellow, text_size = size.tiny)
    table.cell(tab, 0, 1, "VWAP", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 1, 1, str.tostring(nV), text_color = color.white, text_size = size.tiny)
    table.cell(tab, 2, 1, na(pct(nV, tV)) ? "—" : str.tostring(pct(nV, tV), "#") + "%", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 0, 2, "EMA", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 1, 2, str.tostring(nE), text_color = color.white, text_size = size.tiny)
    table.cell(tab, 2, 2, na(pct(nE, tE)) ? "—" : str.tostring(pct(nE, tE), "#") + "%", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 0, 3, "BOS", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 1, 3, str.tostring(nB), text_color = color.white, text_size = size.tiny)
    table.cell(tab, 2, 3, na(pct(nB, tB)) ? "—" : str.tostring(pct(nB, tB), "#") + "%", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 0, 4, "SWEEP", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 1, 4, str.tostring(nS), text_color = color.white, text_size = size.tiny)
    table.cell(tab, 2, 4, na(pct(nS, tS)) ? "—" : str.tostring(pct(nS, tS), "#") + "%", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 0, 5, "DIV", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 1, 5, str.tostring(nD), text_color = color.white, text_size = size.tiny)
    table.cell(tab, 2, 5, na(pct(nD, tD)) ? "—" : str.tostring(pct(nD, tD), "#") + "%", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 0, 6, "ORB", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 1, 6, str.tostring(nO), text_color = color.white, text_size = size.tiny)
    table.cell(tab, 2, 6, na(pct(nO, tO)) ? "—" : str.tostring(pct(nO, tO), "#") + "%", text_color = color.white, text_size = size.tiny)
    table.cell(tab, 0, 7, "Now", text_color = color.gray, text_size = size.tiny)
    table.cell(tab, 1, 7, tradeDir == 0 ? "flat" : tSetup, text_color = color.white, text_size = size.tiny)
    table.cell(tab, 2, 7, tradeDir == 1 ? "LONG" : tradeDir == -1 ? "SHORT" : "—", text_color = tradeDir == 1 ? colL : tradeDir == -1 ? colS : color.gray, text_size = size.tiny)

if fire
    alert("Scanner " + setupName + (rawDir == 1 ? " LONG " : " SHORT ") + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
alertcondition(fire and rawDir == 1, "Any long setup", "Scanner long")
alertcondition(fire and rawDir == -1, "Any short setup", "Scanner short")
