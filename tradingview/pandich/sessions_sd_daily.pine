//@version=6
// Pandich Sessions + Supply & Demand Daily — full recreation (LuxAlgo-style combine).
// Up to 4 sessions with range / mean / VWAP / completed max-min.
// Daily S/D: previous day range split into bins, volume accumulated top→supply / bottom→demand until Threshold %.
indicator("Pandich Sessions + S/D Daily [65]", overlay = true, max_boxes_count = 150, max_lines_count = 100, max_labels_count = 60, max_bars_back = 2000)

grpA = "Session A · NY"
aOn = input.bool(true, "Enable A", group = grpA)
aName = input.string("New York", "Name", group = grpA)
aSess = input.session("1300-2200", "Hours (exchange/UTC per chart)", group = grpA)
aCol = input.color(color.new(#2962FF, 82), "Color", group = grpA)

grpB = "Session B · London"
bOn = input.bool(true, "Enable B", group = grpB)
bName = input.string("London", "Name", group = grpB)
bSess = input.session("0700-1600", "Hours", group = grpB)
bCol = input.color(color.new(#FF6D00, 82), "Color", group = grpB)

grpC = "Session C · Tokyo"
cOn = input.bool(true, "Enable C", group = grpC)
cName = input.string("Tokyo", "Name", group = grpC)
cSess = input.session("0000-0900", "Hours", group = grpC)
cCol = input.color(color.new(#00C853, 82), "Color", group = grpC)

grpD = "Session D · Sydney"
dOn = input.bool(false, "Enable D", group = grpD)
dName = input.string("Sydney", "Name", group = grpD)
dSess = input.session("2100-0600", "Hours", group = grpD)
dCol = input.color(color.new(#AA00FF, 82), "Color", group = grpD)

grpS = "Session visuals"
showRange = input.bool(true, "Range box", group = grpS)
showMean = input.bool(true, "Mean close", group = grpS)
showVwap = input.bool(true, "Session VWAP", group = grpS)
showMaxMin = input.bool(true, "Extend completed Max/Min", group = grpS)
showDash = input.bool(true, "Dashboard", group = grpS)

grpZ = "Supply & Demand Daily"
sdOn = input.bool(true, "Enable daily S/D", group = grpZ)
thrPct = input.float(20.0, "Threshold % of day volume", minval = 1, maxval = 90, group = grpZ)
binsN = input.int(24, "Resolution (bins)", minval = 8, maxval = 80, group = grpZ)
keepDays = input.int(5, "History days on chart", minval = 1, maxval = 20, group = grpZ)
supCol = input.color(color.new(#F6465D, 78), "Supply fill", group = grpZ)
demCol = input.color(color.new(#0ECB81, 78), "Demand fill", group = grpZ)
showAvg = input.bool(true, "Zone mid line", group = grpZ)
showWt = input.bool(true, "Zone weighted line", group = grpZ)

activeA = aOn and not na(time(timeframe.period, aSess))
activeB = bOn and not na(time(timeframe.period, bSess))
activeC = cOn and not na(time(timeframe.period, cSess))
activeD = dOn and not na(time(timeframe.period, dSess))

// ——— Session A state ———
var float aHi = na
var float aLo = na
var float aSumC = 0.0
var float aSumCV = 0.0
var float aSumV = 0.0
var int aN = 0
var int aStart = na
var box aBx = na
var line aMean = na
var line aVwap = na
var float aMaxDone = na
var float aMinDone = na
var line aMaxLn = na
var line aMinLn = na

if activeA and not activeA[1]
    box.delete(aBx)
    line.delete(aMean)
    line.delete(aVwap)
    aHi := high
    aLo := low
    aSumC := close
    aSumCV := close * volume
    aSumV := volume
    aN := 1
    aStart := bar_index
    if showRange
        aBx := box.new(bar_index, aHi, bar_index, aLo, bgcolor = aCol, border_color = color.new(aCol, 30))
else if activeA
    aHi := math.max(aHi, high)
    aLo := math.min(aLo, low)
    aSumC += close
    aSumCV += close * volume
    aSumV += volume
    aN += 1
    if showRange and not na(aBx)
        box.set_right(aBx, bar_index)
        box.set_top(aBx, aHi)
        box.set_bottom(aBx, aLo)
    if showMean and aN > 0
        line.delete(aMean)
        aMean := line.new(aStart, aSumC / aN, bar_index, aSumC / aN, color = color.new(aCol, 0), width = 1, style = line.style_dotted)
    if showVwap and aSumV > 0
        line.delete(aVwap)
        aVwap := line.new(aStart, aSumCV / aSumV, bar_index, aSumCV / aSumV, color = color.new(aCol, 0), width = 1)
else if not activeA and activeA[1]
    aMaxDone := aHi
    aMinDone := aLo
    label.new(bar_index, aHi, aName, style = label.style_label_down, color = color.new(aCol, 0), textcolor = color.white, size = size.tiny)
    if showMaxMin
        line.delete(aMaxLn)
        line.delete(aMinLn)
        aMaxLn := line.new(bar_index, aMaxDone, bar_index + 50, aMaxDone, color = color.new(aCol, 0), style = line.style_dashed)
        aMinLn := line.new(bar_index, aMinDone, bar_index + 50, aMinDone, color = color.new(aCol, 0), style = line.style_dashed)

// Session B
var float bHi = na
var float bLo = na
var float bSumC = 0.0
var float bSumCV = 0.0
var float bSumV = 0.0
var int bN = 0
var int bStart = na
var box bBx = na
var line bMean = na
var line bVwap = na
var float bMaxDone = na
var float bMinDone = na
var line bMaxLn = na
var line bMinLn = na

if activeB and not activeB[1]
    box.delete(bBx)
    line.delete(bMean)
    line.delete(bVwap)
    bHi := high
    bLo := low
    bSumC := close
    bSumCV := close * volume
    bSumV := volume
    bN := 1
    bStart := bar_index
    if showRange
        bBx := box.new(bar_index, bHi, bar_index, bLo, bgcolor = bCol, border_color = color.new(bCol, 30))
else if activeB
    bHi := math.max(bHi, high)
    bLo := math.min(bLo, low)
    bSumC += close
    bSumCV += close * volume
    bSumV += volume
    bN += 1
    if showRange and not na(bBx)
        box.set_right(bBx, bar_index)
        box.set_top(bBx, bHi)
        box.set_bottom(bBx, bLo)
    if showMean and bN > 0
        line.delete(bMean)
        bMean := line.new(bStart, bSumC / bN, bar_index, bSumC / bN, color = color.new(bCol, 0), width = 1, style = line.style_dotted)
    if showVwap and bSumV > 0
        line.delete(bVwap)
        bVwap := line.new(bStart, bSumCV / bSumV, bar_index, bSumCV / bSumV, color = color.new(bCol, 0), width = 1)
else if not activeB and activeB[1]
    bMaxDone := bHi
    bMinDone := bLo
    label.new(bar_index, bHi, bName, style = label.style_label_down, color = color.new(bCol, 0), textcolor = color.white, size = size.tiny)
    if showMaxMin
        line.delete(bMaxLn)
        line.delete(bMinLn)
        bMaxLn := line.new(bar_index, bMaxDone, bar_index + 50, bMaxDone, color = color.new(bCol, 0), style = line.style_dashed)
        bMinLn := line.new(bar_index, bMinDone, bar_index + 50, bMinDone, color = color.new(bCol, 0), style = line.style_dashed)

// Session C
var float cHi = na
var float cLo = na
var float cSumC = 0.0
var float cSumCV = 0.0
var float cSumV = 0.0
var int cN = 0
var int cStart = na
var box cBx = na
var line cMean = na
var line cVwap = na

if activeC and not activeC[1]
    box.delete(cBx)
    line.delete(cMean)
    line.delete(cVwap)
    cHi := high
    cLo := low
    cSumC := close
    cSumCV := close * volume
    cSumV := volume
    cN := 1
    cStart := bar_index
    if showRange
        cBx := box.new(bar_index, cHi, bar_index, cLo, bgcolor = cCol, border_color = color.new(cCol, 30))
else if activeC
    cHi := math.max(cHi, high)
    cLo := math.min(cLo, low)
    cSumC += close
    cSumCV += close * volume
    cSumV += volume
    cN += 1
    if showRange and not na(cBx)
        box.set_right(cBx, bar_index)
        box.set_top(cBx, cHi)
        box.set_bottom(cBx, cLo)
    if showMean and cN > 0
        line.delete(cMean)
        cMean := line.new(cStart, cSumC / cN, bar_index, cSumC / cN, color = color.new(cCol, 0), width = 1, style = line.style_dotted)
    if showVwap and cSumV > 0
        line.delete(cVwap)
        cVwap := line.new(cStart, cSumCV / cSumV, bar_index, cSumCV / cSumV, color = color.new(cCol, 0), width = 1)
else if not activeC and activeC[1]
    label.new(bar_index, cHi, cName, style = label.style_label_down, color = color.new(cCol, 0), textcolor = color.white, size = size.tiny)

// Session D
var float dHi = na
var float dLo = na
var float dSumC = 0.0
var float dSumCV = 0.0
var float dSumV = 0.0
var int dN = 0
var int dStart = na
var box dBx = na
var line dMean = na
var line dVwap = na

if activeD and not activeD[1]
    box.delete(dBx)
    line.delete(dMean)
    line.delete(dVwap)
    dHi := high
    dLo := low
    dSumC := close
    dSumCV := close * volume
    dSumV := volume
    dN := 1
    dStart := bar_index
    if showRange
        dBx := box.new(bar_index, dHi, bar_index, dLo, bgcolor = dCol, border_color = color.new(dCol, 30))
else if activeD
    dHi := math.max(dHi, high)
    dLo := math.min(dLo, low)
    dSumC += close
    dSumCV += close * volume
    dSumV += volume
    dN += 1
    if showRange and not na(dBx)
        box.set_right(dBx, bar_index)
        box.set_top(dBx, dHi)
        box.set_bottom(dBx, dLo)
    if showMean and dN > 0
        line.delete(dMean)
        dMean := line.new(dStart, dSumC / dN, bar_index, dSumC / dN, color = color.new(dCol, 0), width = 1, style = line.style_dotted)
    if showVwap and dSumV > 0
        line.delete(dVwap)
        dVwap := line.new(dStart, dSumCV / dSumV, bar_index, dSumCV / dSumV, color = color.new(dCol, 0), width = 1)
else if not activeD and activeD[1]
    label.new(bar_index, dHi, dName, style = label.style_label_down, color = color.new(dCol, 0), textcolor = color.white, size = size.tiny)

if showMaxMin and not na(aMaxLn) and barstate.islast
    line.set_x2(aMaxLn, bar_index + 2)
    line.set_x2(aMinLn, bar_index + 2)
if showMaxMin and not na(bMaxLn) and barstate.islast
    line.set_x2(bMaxLn, bar_index + 2)
    line.set_x2(bMinLn, bar_index + 2)

// ——— Daily volume-profile S/D ———
newDay = ta.change(time("D")) != 0
var array<float> binVol = array.new_float()
var float dayHi = na
var float dayLo = na
var float dayVol = 0.0
var int dayStart = na
var array<box> histSup = array.new_box()
var array<box> histDem = array.new_box()
var array<line> histLn = array.new_line()

if newDay
    // finalize previous day → zones from volume bins
    if sdOn and not na(dayHi) and not na(dayLo) and dayHi > dayLo and dayVol > 0 and array.size(binVol) == binsN
        step = (dayHi - dayLo) / binsN
        thr = dayVol * thrPct / 100.0
        acc = 0.0
        sTop = dayHi
        sBot = dayHi
        wtSum = 0.0
        wtVol = 0.0
        for i = binsN - 1 to 0
            v = array.get(binVol, i)
            mid = dayLo + (i + 0.5) * step
            acc += v
            wtSum += mid * v
            wtVol += v
            sBot := dayLo + i * step
            if acc >= thr
                break
        acc2 = 0.0
        dBot = dayLo
        dTop = dayLo
        wtSum2 = 0.0
        wtVol2 = 0.0
        for i = 0 to binsN - 1
            v = array.get(binVol, i)
            mid = dayLo + (i + 0.5) * step
            acc2 += v
            wtSum2 += mid * v
            wtVol2 += v
            dTop := dayLo + (i + 1) * step
            if acc2 >= thr
                break
        x1 = dayStart
        x2 = bar_index + 30
        array.push(histSup, box.new(x1, sTop, x2, sBot, bgcolor = supCol, border_color = color.new(supCol, 40)))
        array.push(histDem, box.new(x1, dTop, x2, dBot, bgcolor = demCol, border_color = color.new(demCol, 40)))
        if showAvg
            array.push(histLn, line.new(x1, (sTop + sBot) / 2, x2, (sTop + sBot) / 2, color = color.new(supCol, 0), width = 1))
            array.push(histLn, line.new(x1, (dTop + dBot) / 2, x2, (dTop + dBot) / 2, color = color.new(demCol, 0), width = 1))
        if showWt and wtVol > 0 and wtVol2 > 0
            array.push(histLn, line.new(x1, wtSum / wtVol, x2, wtSum / wtVol, color = color.new(supCol, 0), style = line.style_dashed))
            array.push(histLn, line.new(x1, wtSum2 / wtVol2, x2, wtSum2 / wtVol2, color = color.new(demCol, 0), style = line.style_dashed))
        while array.size(histSup) > keepDays
            box.delete(array.shift(histSup))
        while array.size(histDem) > keepDays
            box.delete(array.shift(histDem))
        while array.size(histLn) > keepDays * 4
            line.delete(array.shift(histLn))
    dayHi := high
    dayLo := low
    dayVol := volume
    dayStart := bar_index
    array.clear(binVol)
    for bi = 0 to binsN - 1
        array.push(binVol, 0.0)
else
    if na(dayHi)
        dayHi := high
        dayLo := low
        dayVol := volume
        dayStart := bar_index
        array.clear(binVol)
        for bi = 0 to binsN - 1
            array.push(binVol, 0.0)
    else
        dayHi := math.max(dayHi, high)
        dayLo := math.min(dayLo, low)
        dayVol += volume

// accumulate current bar volume into bins of *current* day range (approximate; locks better at day end)
if sdOn and not na(dayHi) and dayHi > dayLo and array.size(binVol) == binsN
    step = (dayHi - dayLo) / binsN
    // distribute bar volume across bins it spans
    i0 = int(math.floor((low - dayLo) / step))
    i1 = int(math.floor((high - dayLo) / step))
    i0 := math.max(0, math.min(binsN - 1, i0))
    i1 := math.max(0, math.min(binsN - 1, i1))
    nSpan = math.max(1, i1 - i0 + 1)
    share = volume / nSpan
    for i = i0 to i1
        array.set(binVol, i, array.get(binVol, i) + share)

// extend latest history boxes
if barstate.islast and array.size(histSup) > 0
    box.set_right(array.get(histSup, array.size(histSup) - 1), bar_index + 2)
    box.set_right(array.get(histDem, array.size(histDem) - 1), bar_index + 2)

if showDash
    var table t = table.new(position.bottom_left, 2, 6, bgcolor = color.new(#0B0E11, 8), border_width = 1, border_color = #2B3139)
    if barstate.islast
        table.cell(t, 0, 0, "Sessions+S/D", text_color = color.yellow, text_size = size.small)
        table.cell(t, 1, 0, "map", text_color = color.white, text_size = size.small)
        table.cell(t, 0, 1, aName, text_color = color.gray, text_size = size.tiny)
        table.cell(t, 1, 1, activeA ? "ACTIVE" : aOn ? "idle" : "off", text_color = color.white, text_size = size.tiny)
        table.cell(t, 0, 2, bName, text_color = color.gray, text_size = size.tiny)
        table.cell(t, 1, 2, activeB ? "ACTIVE" : bOn ? "idle" : "off", text_color = color.white, text_size = size.tiny)
        table.cell(t, 0, 3, cName, text_color = color.gray, text_size = size.tiny)
        table.cell(t, 1, 3, activeC ? "ACTIVE" : cOn ? "idle" : "off", text_color = color.white, text_size = size.tiny)
        table.cell(t, 0, 4, "Day range", text_color = color.gray, text_size = size.tiny)
        table.cell(t, 1, 4, na(dayHi) ? "—" : str.tostring(dayLo, format.mintick) + "–" + str.tostring(dayHi, format.mintick), text_color = color.white, text_size = size.tiny)
        table.cell(t, 0, 5, "S/D bins", text_color = color.gray, text_size = size.tiny)
        table.cell(t, 1, 5, str.tostring(binsN) + " · thr " + str.tostring(thrPct, "#") + "% · hist " + str.tostring(array.size(histSup)), text_color = color.white, text_size = size.tiny)
