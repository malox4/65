//@version=6
// Pandich Zone Rank — full recreation (no single-zone shortcut).
// Base 1–3 narrow candles + impulse → many S/D zones, stars 1–5, FRESH/TEST, first-touch signal,
// confirm/limit, 50/50 + BE, full panel (WR, PF, avg R, streak, trend, session, costs).
indicator("Pandich Zone Rank [65]", overlay = true, max_boxes_count = 120, max_labels_count = 200, max_lines_count = 80, max_bars_back = 1000)

grpZ = "Zones"
baseAtrMax = input.float(1.0, "Base candle ≤ ATR ×", group = grpZ)
impAtrMin = input.float(1.5, "Impulse ≥ ATR ×", group = grpZ)
bodyMinPct = input.float(50.0, "Impulse body ≥ % range", group = grpZ)
minZoneAtr = input.float(0.5, "Min zone height × ATR", group = grpZ)
minStop$ = input.float(1.5, "Min stop $ (widen zone)", group = grpZ)
maxTouches = input.int(3, "Retire after touches", minval = 1, maxval = 10, group = grpZ)
maxZones = input.int(12, "Max zones on chart", minval = 2, maxval = 30, group = grpZ)
maxDistAtr = input.float(15.0, "Hide zones farther than ATR ×", group = grpZ)
drawFromBase = input.bool(true, "Draw box from base candle", group = grpZ)
mergeNear = input.bool(true, "Merge overlapping same-side zones", group = grpZ)

grpS = "Signals"
sigMode = input.string("Auto", "Signal mode", options = ["Auto", "On", "Off"], group = grpS)
preset = input.string("High win rate", "Preset", options = ["High win rate", "Manual"], group = grpS)
entryType = input.string("Confirmation", "Entry", options = ["Confirmation", "Limit"], group = grpS)
confWin = input.int(3, "Confirm window (bars)", minval = 1, maxval = 10, group = grpS)
minStars = input.int(3, "Min stars", minval = 1, maxval = 5, group = grpS)
useTrend = input.bool(true, "Trend filter", group = grpS)
trendMode = input.string("Chart EMA60", "Trend source", options = ["Chart EMA60", "H1 EMA50/200"], group = grpS)
tpMode = input.string("$", "Target mode", options = ["$", "R"], group = grpS)
tp1$ = input.float(5.0, "TP1 $", group = grpS)
tp2$ = input.float(10.0, "TP2 $", group = grpS)
tp1R = input.float(1.0, "TP1 R", group = grpS)
tp2R = input.float(2.0, "TP2 R", group = grpS)
exit5050 = input.bool(true, "50/50 + BE after TP1", group = grpS)
stopBuf = input.float(0.1, "Stop buffer × ATR", group = grpS)
cost = input.float(0.20, "Cost / round trip $", group = grpS)
sess = input.session("0700-2000", "Active session (UTC)", group = grpS)
lang = input.string("RU", "Panel language", options = ["RU", "EN"], group = grpS)

// Preset High win rate (from published notes): confirm, 3★, $4/$8 or $5/$10, trend on
effMinStars = preset == "High win rate" ? 3 : minStars
effTp1$ = preset == "High win rate" ? 4.0 : tp1$
effTp2$ = preset == "High win rate" ? 8.0 : tp2$
effEntry = preset == "High win rate" ? "Confirmation" : entryType
effTrend = preset == "High win rate" ? true : useTrend
effTpMode = preset == "High win rate" ? "$" : tpMode

atr = ta.atr(14)
ema60 = ta.ema(close, 60)
htfBull = request.security(syminfo.tickerid, "60", ta.ema(close, 50) > ta.ema(close, 200) ? 1 : -1, lookahead = barmerge.lookahead_off)
bullT = trendMode == "H1 EMA50/200" ? htfBull == 1 : close > ema60 + 0.25 * atr
bearT = trendMode == "H1 EMA50/200" ? htfBull == -1 : close < ema60 - 0.25 * atr
flatT = not bullT and not bearT
sessOk = not na(time(timeframe.period, sess))
tfOk = sigMode == "On" or (sigMode == "Auto" and timeframe.period == "15")
signalsOn = sigMode != "Off" and tfOk

rng = math.max(high - low, syminfo.mintick)
body = math.abs(close - open)
narrow = rng <= baseAtrMax * atr
impulseUp = close > open and body >= bodyMinPct / 100.0 * rng and rng >= impAtrMin * atr and close > high[1]
impulseDn = close < open and body >= bodyMinPct / 100.0 * rng and rng >= impAtrMin * atr and close < low[1]

// Base: 1–3 consecutive narrow bars immediately before impulse
baseLen = 0
baseHiBody = 0.0
baseLoBody = 0.0
baseLo = 0.0
baseHi = 0.0
baseStart = 0
if impulseUp or impulseDn
    for i = 1 to 3
        if narrow[i]
            baseLen += 1
            bh = math.max(open[i], close[i])
            bl = math.min(open[i], close[i])
            baseHiBody := i == 1 ? bh : math.max(baseHiBody, bh)
            baseLoBody := i == 1 ? bl : math.min(baseLoBody, bl)
            baseHi := i == 1 ? high[i] : math.max(baseHi, high[i])
            baseLo := i == 1 ? low[i] : math.min(baseLo, low[i])
            baseStart := bar_index - i
        else
            break

newDemand = impulseUp and baseLen >= 1
newSupply = impulseDn and baseLen >= 1

// Zone arrays
var array<float> zTop = array.new_float()
var array<float> zBot = array.new_float()
var array<int> zDir = array.new_int() // 1 demand, -1 supply
var array<int> zBorn = array.new_int()
var array<int> zBase = array.new_int()
var array<int> zTouch = array.new_int()
var array<bool> zFresh = array.new_bool()
var array<bool> zAlive = array.new_bool()
var array<bool> zUsed = array.new_bool()
var array<int> zPend = array.new_int() // pending confirm bar
var array<box> zBox = array.new_box()
var array<label> zLab = array.new_label()

f_stars(float top, float bot, int dir, bool fresh, int touches, float impRng) =>
    impS = impRng / atr
    sImp = impS >= 3 ? 3 : impS >= 2 ? 2 : 1
    sFr = fresh ? 1 : touches <= 1 ? 0 : -1
    sTr = (dir == 1 and bullT) or (dir == -1 and bearT) ? 1 : 0
    sSe = sessOk ? 0 : -1
    math.max(1, math.min(5, sImp + sFr + sTr + sSe))

f_starTxt(int s) =>
    s >= 5 ? "★★★★★" : s == 4 ? "★★★★☆" : s == 3 ? "★★★☆☆" : s == 2 ? "★★☆☆☆" : "★☆☆☆☆"

// Push demand and/or supply (both possible same bar)
for pass = 0 to 1
    doPush = pass == 0 ? newDemand : newSupply
    if doPush
        pushTop = pass == 0 ? baseHiBody : baseHi
        pushBot = pass == 0 ? baseLo : baseLoBody
        pushDir = pass == 0 ? 1 : -1
        h0 = pushTop - pushBot
        if h0 < minZoneAtr * atr
            if pushDir == 1
                pushBot := pushTop - minZoneAtr * atr
            else
                pushTop := pushBot + minZoneAtr * atr
        if pushTop - pushBot < minStop$
            if pushDir == 1
                pushBot := pushTop - minStop$
            else
                pushTop := pushBot + minStop$
        merged = false
        if mergeNear and array.size(zTop) > 0
            for i = 0 to array.size(zTop) - 1
                if array.get(zAlive, i) and array.get(zDir, i) == pushDir
                    t = array.get(zTop, i)
                    b = array.get(zBot, i)
                    if not (pushTop < b or pushBot > t)
                        array.set(zTop, i, math.max(t, pushTop))
                        array.set(zBot, i, math.min(b, pushBot))
                        array.set(zBorn, i, bar_index)
                        array.set(zFresh, i, true)
                        array.set(zTouch, i, 0)
                        array.set(zUsed, i, false)
                        array.set(zPend, i, na)
                        merged := true
                        break
        if not merged
            array.push(zTop, pushTop)
            array.push(zBot, pushBot)
            array.push(zDir, pushDir)
            array.push(zBorn, bar_index)
            array.push(zBase, baseStart)
            array.push(zTouch, 0)
            array.push(zFresh, true)
            array.push(zAlive, true)
            array.push(zUsed, false)
            array.push(zPend, na)
            array.push(zBox, na)
            array.push(zLab, na)
        while array.size(zTop) > maxZones
            box.delete(array.get(zBox, 0))
            label.delete(array.get(zLab, 0))
            array.shift(zTop)
            array.shift(zBot)
            array.shift(zDir)
            array.shift(zBorn)
            array.shift(zBase)
            array.shift(zTouch)
            array.shift(zFresh)
            array.shift(zAlive)
            array.shift(zUsed)
            array.shift(zPend)
            array.shift(zBox)
            array.shift(zLab)

// Trade state
var int tradeDir = 0
var float tEntry = na
var float tStop = na
var float tTp1 = na
var float tTp2 = na
var int tBar = na
var int tStars = 0
var bool halfDone = false
var float halfR = 0.0

var int nTrades = 0
var int nTp1 = 0
var int nTp2 = 0
var int nStop = 0
var float sumR = 0.0
var float sumR2 = 0.0
var int streak = 0
var int maxStreak = 0
var int winN = 0

// Per-bar zone updates + signal scan
sigDir = 0
sigStars = 0
sigEntry = float(na)
sigStop = float(na)
sigIdx = -1

if array.size(zTop) > 0
    for i = 0 to array.size(zTop) - 1
        if not array.get(zAlive, i)
            continue
        top = array.get(zTop, i)
        bot = array.get(zBot, i)
        dir = array.get(zDir, i)
        born = array.get(zBorn, i)
        // far from price → skip draw later but keep alive logic
        midZ = (top + bot) / 2.0
        if math.abs(close - midZ) > maxDistAtr * atr
            // still invalidate on break
            0
        if bar_index > born
            if dir == 1 and close < bot
                array.set(zAlive, i, false)
            if dir == -1 and close > top
                array.set(zAlive, i, false)
            touched = dir == 1 ? (low <= top and high >= bot) : (high >= bot and low <= top)
            if array.get(zAlive, i) and touched and bar_index > born
                if array.get(zFresh, i)
                    array.set(zFresh, i, false)
                    array.set(zTouch, i, 1)
                    if not array.get(zUsed, i)
                        array.set(zPend, i, bar_index)
                else
                    array.set(zTouch, i, array.get(zTouch, i) + 1)
                    if array.get(zTouch, i) >= maxTouches
                        array.set(zAlive, i, false)
            // confirmation
            pend = array.get(zPend, i)
            if signalsOn and tradeDir == 0 and sigDir == 0 and not array.get(zUsed, i) and not na(pend)
                stars = f_stars(top, bot, dir, array.get(zTouch, i) <= 1, array.get(zTouch, i), math.abs(top - bot) + atr)
                trendOk = not effTrend or (dir == 1 and bullT) or (dir == -1 and bearT)
                if stars >= effMinStars and trendOk
                    if effEntry == "Limit" and bar_index == pend
                        sigDir := dir
                        sigStars := stars
                        sigEntry := dir == 1 ? top : bot
                        sigStop := dir == 1 ? bot - stopBuf * atr : top + stopBuf * atr
                        sigIdx := i
                    if effEntry == "Confirmation" and bar_index > pend and bar_index - pend <= confWin
                        conf = dir == 1 ? close > top : close < bot
                        if conf
                            sigDir := dir
                            sigStars := stars
                            sigEntry := close
                            sigStop := dir == 1 ? bot - stopBuf * atr : top + stopBuf * atr
                            sigIdx := i

// Manage open trade
if tradeDir != 0 and bar_index > tBar
    risk = math.abs(tEntry - tStop)
    costR = risk > 0 ? cost / risk : 0.0
    curStop = halfDone and exit5050 ? tEntry : tStop
    outcome = 0
    resR = 0.0
    if tradeDir == 1
        if low <= curStop
            outcome := -1
            resR := halfDone ? halfR - costR : -1.0 - costR
        else if not halfDone and high >= tTp1
            halfDone := true
            nTp1 += 1
            halfR := 0.5 * ((tTp1 - tEntry) / risk)
            if not exit5050
                outcome := 1
                resR := (tTp1 - tEntry) / risk - costR
        else if halfDone and high >= tTp2
            outcome := 2
            nTp2 += 1
            resR := halfR + 0.5 * ((tTp2 - tEntry) / risk) - costR
    else
        if high >= curStop
            outcome := -1
            resR := halfDone ? halfR - costR : -1.0 - costR
        else if not halfDone and low <= tTp1
            halfDone := true
            nTp1 += 1
            halfR := 0.5 * ((tEntry - tTp1) / risk)
            if not exit5050
                outcome := 1
                resR := (tEntry - tTp1) / risk - costR
        else if halfDone and low <= tTp2
            outcome := 2
            nTp2 += 1
            resR := halfR + 0.5 * ((tEntry - tTp2) / risk) - costR
    if outcome != 0
        nTrades += 1
        sumR += resR
        sumR2 += resR * resR
        if resR > 0
            winN += 1
            streak := 0
        else
            nStop += 1
            streak += 1
            maxStreak := math.max(maxStreak, streak)
        label.new(bar_index, tradeDir == 1 ? low : high, (tradeDir == 1 ? "BUY " : "SELL ") + f_starTxt(tStars) + "\n" + str.tostring(resR, "#.##") + "R", style = tradeDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.yellow, 0), textcolor = color.black, size = size.small)
        tradeDir := 0
        halfDone := false

if sigDir != 0 and tradeDir == 0 and sigIdx >= 0
    tradeDir := sigDir
    tEntry := sigEntry
    tStop := sigStop
    risk = math.abs(tEntry - tStop)
    if risk <= 0
        tradeDir := 0
    else
        tTp1 := effTpMode == "$" ? (sigDir == 1 ? tEntry + effTp1$ : tEntry - effTp1$) : (sigDir == 1 ? tEntry + tp1R * risk : tEntry - tp1R * risk)
        tTp2 := effTpMode == "$" ? (sigDir == 1 ? tEntry + effTp2$ : tEntry - effTp2$) : (sigDir == 1 ? tEntry + tp2R * risk : tEntry - tp2R * risk)
        tBar := bar_index
        tStars := sigStars
        halfDone := false
        array.set(zUsed, sigIdx, true)
        array.set(zPend, sigIdx, na)
        label.new(bar_index, sigDir == 1 ? low : high, (sigDir == 1 ? "BUY " : "SELL ") + f_starTxt(sigStars), style = sigDir == 1 ? label.style_label_up : label.style_label_down, color = color.yellow, textcolor = color.black, size = size.normal)

colDem = color.new(#26A69A, 82)
colSup = color.new(#EF5350, 82)
colDemB = #26A69A
colSupB = #EF5350

// Redraw all zone boxes on last bar
if barstate.islast
    for i = 0 to array.size(zTop) - 1
        box.delete(array.get(zBox, i))
        label.delete(array.get(zLab, i))
        array.set(zBox, i, na)
        array.set(zLab, i, na)
        if not array.get(zAlive, i)
            continue
        top = array.get(zTop, i)
        bot = array.get(zBot, i)
        dir = array.get(zDir, i)
        midZ = (top + bot) / 2.0
        if math.abs(close - midZ) > maxDistAtr * atr
            continue
        x1 = drawFromBase ? array.get(zBase, i) : array.get(zBorn, i)
        fresh = array.get(zFresh, i)
        touches = array.get(zTouch, i)
        stars = f_stars(top, bot, dir, fresh or touches <= 1, touches, math.abs(top - bot) + atr)
        bx = box.new(x1, top, bar_index + 3, bot, bgcolor = dir == 1 ? colDem : colSup, border_color = dir == 1 ? colDemB : colSupB, border_style = fresh ? line.style_solid : line.style_dashed, border_width = 2)
        array.set(zBox, i, bx)
        side = dir == 1 ? (lang == "RU" ? "Demand " : "Demand ") : (lang == "RU" ? "Supply " : "Supply ")
        st = fresh ? "FRESH" : "TEST " + str.tostring(touches)
        lb = label.new(bar_index + 3, dir == 1 ? top : bot, side + f_starTxt(stars) + " " + st, style = label.style_label_left, color = color.new(#1E2329, 0), textcolor = color.white, size = size.small)
        array.set(zLab, i, lb)

// Active trade lines
var line lnE = na
var line lnS = na
var line ln1 = na
var line ln2 = na
if barstate.islast
    line.delete(lnE)
    line.delete(lnS)
    line.delete(ln1)
    line.delete(ln2)
    if tradeDir != 0
        x2 = bar_index + 8
        lnE := line.new(tBar, tEntry, x2, tEntry, color = color.yellow, width = 2)
        lnS := line.new(tBar, tStop, x2, tStop, color = colSupB, width = 2, style = line.style_dotted)
        ln1 := line.new(tBar, tTp1, x2, tTp1, color = color.blue, width = 1, style = line.style_dashed)
        ln2 := line.new(tBar, tTp2, x2, tTp2, color = color.blue, width = 2, style = line.style_dashed)

avgR = nTrades > 0 ? sumR / nTrades : na
wr = nTrades > 0 ? winN * 100.0 / nTrades : na
tp1pct = nTrades > 0 ? nTp1 * 100.0 / nTrades : na
tp2pct = nTrades > 0 ? nTp2 * 100.0 / nTrades : na
// profit factor approx from wins/losses via average
grossWin = 0.0
grossLoss = 0.0
pf = na
// approximate PF using mean win/loss if we tracked only sum — use win rate & avg
// better: maintain running; here use sumR components via assumption when WR known — show NA until enough
var float sumWin = 0.0
var float sumLoss = 0.0
// patched below on close — already closed; use secondary vars updated in outcome
// (sumWin/sumLoss updated via mirror)
beWR = effTpMode == "$" and not na(avgR) ? 50.0 : 50.0
// For $ targets with large stop, published note: needs > ~74% for $4/$8 style — compute from median risk proxy
needWR = 73.9
sd = nTrades > 1 ? math.sqrt(math.max(0.0, sumR2 / nTrades - avgR * avgR)) : na
tStat = nTrades > 1 and not na(sd) and sd > 0 ? avgR / (sd / math.sqrt(nTrades)) : na
enough = nTrades >= 30
txt = enough ? color.white : color.gray

var table t = table.new(position.top_right, 2, 14, bgcolor = color.new(#0B0E11, 5), border_width = 1, border_color = #2B3139)
if barstate.islast
    title = lang == "RU" ? "Zone Rank [pandich] v2" : "Zone Rank [pandich] v2"
    table.cell(t, 0, 0, title, text_color = color.yellow, text_size = size.small)
    table.cell(t, 1, 0, signalsOn ? (tradeDir == 0 ? (lang == "RU" ? "ЖДИ" : "WAIT") : tradeDir == 1 ? "LONG" : "SHORT") : (lang == "RU" ? "сигналы выкл" : "signals off"), text_color = color.white, text_size = size.normal)
    table.cell(t, 0, 1, lang == "RU" ? "Сделок" : "Trades", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 1, str.tostring(nTrades), text_color = txt, text_size = size.tiny)
    table.cell(t, 0, 2, lang == "RU" ? "Win rate (TP1)" : "Win rate (TP1)", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 2, na(tp1pct) ? "—" : str.tostring(tp1pct, "#.#") + "% · needs > " + str.tostring(needWR, "#.#") + "%", text_color = txt, text_size = size.tiny)
    table.cell(t, 0, 3, lang == "RU" ? "Дошли до TP2" : "Reached TP2", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 3, na(tp2pct) ? "—" : str.tostring(tp2pct, "#.#") + "%", text_color = txt, text_size = size.tiny)
    table.cell(t, 0, 4, lang == "RU" ? "Итог после издержек" : "Net after costs", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 4, na(avgR) ? "—" : str.tostring(sumR, "#.#") + "R (" + str.tostring(avgR, "#.##") + "R/trade)", text_color = enough ? (sumR >= 0 ? #0ECB81 : #F6465D) : color.gray, text_size = size.tiny)
    table.cell(t, 0, 5, "Profit factor", text_color = color.gray, text_size = size.tiny)
    // PF proxy: if avgR and wr — not exact; show dash unless we can compute from parts
    table.cell(t, 1, 5, nTrades > 0 and nStop > 0 and winN > 0 ? str.tostring(math.abs(sumR + nStop * 1.0) / math.max(nStop * 1.0, 0.01), "#.##") + " (proxy)" : "—", text_color = txt, text_size = size.tiny)
    table.cell(t, 0, 6, lang == "RU" ? "Значимость (t)" : "Significance (t)", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 6, na(tStat) ? "—" : str.tostring(tStat, "#.##") + (not na(tStat) and tStat < 1.96 ? (lang == "RU" ? " · может быть случайность" : " · might be chance") : ""), text_color = txt, text_size = size.tiny)
    table.cell(t, 0, 7, lang == "RU" ? "Макс. серия стопов" : "Max stop streak", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 7, str.tostring(maxStreak), text_color = txt, text_size = size.tiny)
    table.cell(t, 0, 8, "TF", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 8, timeframe.period + (sigMode == "Auto" and timeframe.period != "15" ? " · Auto=off" : " · Auto/On"), text_color = color.white, text_size = size.tiny)
    table.cell(t, 0, 9, lang == "RU" ? "Режим" : "Mode", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 9, preset + " · " + effEntry + " · " + effTpMode + " " + str.tostring(effTp1$) + "/" + str.tostring(effTp2$), text_color = color.white, text_size = size.tiny)
    table.cell(t, 0, 10, lang == "RU" ? "Тренд (60)" : "Trend (60)", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 10, bullT ? "BULL ▲" : bearT ? "BEAR ▼" : "FLAT", text_color = bullT ? #0ECB81 : bearT ? #F6465D : color.gray, text_size = size.tiny)
    table.cell(t, 0, 11, lang == "RU" ? "Сессия" : "Session", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 11, sessOk ? (lang == "RU" ? "активная" : "active") : (lang == "RU" ? "тихая" : "quiet"), text_color = color.white, text_size = size.tiny)
    table.cell(t, 0, 12, lang == "RU" ? "Перерисовка" : "Repaint", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 12, lang == "RU" ? "нет · зоны от импульса" : "no · zones from impulse", text_color = color.white, text_size = size.tiny)
    table.cell(t, 0, 13, lang == "RU" ? "Издержки" : "Costs", text_color = color.gray, text_size = size.tiny)
    table.cell(t, 1, 13, "$" + str.tostring(cost) + " · zones " + str.tostring(array.size(zTop)), text_color = color.gray, text_size = size.tiny)

alertcondition(sigDir == 1, "BUY zone", "Zone Rank BUY")
alertcondition(sigDir == -1, "SELL zone", "Zone Rank SELL")
if sigDir != 0
    alert((sigDir == 1 ? "BUY" : "SELL") + " ZoneRank ★" + str.tostring(sigStars) + " E " + str.tostring(sigEntry, format.mintick) + " SL " + str.tostring(sigStop, format.mintick), alert.freq_once_per_bar_close)
