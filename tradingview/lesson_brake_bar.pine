//@version=6
// Урок 15.02.2023 · Тормозной бар
// История: пример + план куда должна идти цена + куда реально пошла (тейк/стоп/мимо).
indicator("Урок · Тормозной бар", overlay = true, max_lines_count = 100, max_labels_count = 100, max_bars_back = 500)

grp = "План"
volMult   = input.float(1.5, "Объём × SMA", minval = 1.0, step = 0.1, group = grp)
wickPct   = input.float(40.0, "Тень % (тормоз)", minval = 25, maxval = 80, group = grp)
bodyMax   = input.float(55.0, "Макс. тело %", minval = 20, maxval = 70, group = grp)
tpR       = input.float(2.0, "Тейк = риск ×", minval = 1.0, step = 0.5, group = grp)
slPad     = input.float(0.1, "Запас стопа × ATR", minval = 0.0, step = 0.05, group = grp)
liveAtr   = input.float(0.5, "СЕЙЧАС если ≤ ATR× от входа", minval = 0.1, step = 0.05, group = grp)
freshBars = input.int(5, "Сигнал N свечей", minval = 1, maxval = 15, group = grp)
atrLen    = input.int(14, "ATR", group = grp)
showHist  = input.bool(true, "Показывать примеры на истории", group = grp)
lookN     = input.int(25, "Сколько свечей смотреть исход примера", minval = 5, maxval = 80, group = grp)
histDraw  = input.int(8, "Сколько последних примеров с линиями", minval = 1, maxval = 20, group = grp)

colGo = #0ECB81
colStop = #F6465D
colTp = #3B82F6
colWait = #2B3139
colLate = #F6465D
colNow = #F0B90B
colMiss = #848E9C

atr = ta.atr(atrLen)
volSma = ta.sma(volume, 20)
rng = math.max(high - low, syminfo.mintick)
bodyPct = math.abs(close - open) / rng * 100.0
upW = (high - math.max(open, close)) / rng * 100.0
loW = (math.min(open, close) - low) / rng * 100.0
hiVol = volume > volSma * volMult

brakeTop = hiVol and upW >= wickPct and bodyPct <= bodyMax and close < (high + low) / 2.0
brakeBot = hiVol and loW >= wickPct and bodyPct <= bodyMax and close > (high + low) / 2.0

pad = slPad * atr
float entry = na
float stop = na
float take = na
int side = 0
string mode = ""

if brakeBot
    e = (low + close) / 2.0
    s = low - pad
    r = e - s
    if r > 0
        entry := e
        stop := s
        take := e + tpR * r
        side := 1
        mode := "тормоз снизу"

if brakeTop and na(entry)
    e = (high + close) / 2.0
    s = high + pad
    r = s - e
    if r > 0
        entry := e
        stop := s
        take := e - tpR * r
        side := -1
        mode := "тормоз сверху"

var float eMem = na
var float sMem = na
var float tMem = na
var int sideMem = 0
var string modeMem = ""
var int bornMem = na

if not na(entry) and side != 0
    eMem := entry
    sMem := stop
    tMem := take
    sideMem := side
    modeMem := mode
    bornMem := bar_index

haveSig = not na(eMem) and not na(bornMem) and (bar_index - bornMem) <= freshBars
if haveSig
    entry := eMem
    stop := sMem
    take := tMem
    side := sideMem
    mode := modeMem
else
    eMem := na
    sMem := na
    tMem := na
    sideMem := 0
    modeMem := ""
    bornMem := na
    entry := na
    stop := na
    take := na
    side := 0
    mode := ""

nearEntry = haveSig and math.abs(close - entry) <= liveAtr * atr
late = haveSig and not nearEntry and (side == 1 ? close > entry : close < entry)
status = not haveSig ? "WAIT" : nearEntry ? "NOW" : late ? "LATE" : "WAIT_FILL"

// ——— ИСТОРИЯ: метки ———
plotshape(showHist and brakeBot, title = "Пример тормоз ↑", style = shape.triangleup, location = location.belowbar, color = colGo, size = size.small, text = "пример↑\nплан↑", textcolor = colGo)
plotshape(showHist and brakeTop, title = "Пример тормоз ↓", style = shape.triangledown, location = location.abovebar, color = colStop, size = size.small, text = "пример↓\nплан↓", textcolor = colStop)

// ——— Буфер примеров (без глубокого [] — иначе RE10143) ———
// outc: 0=ещё идёт, 1=тейк, -1=стоп, 2=мимо
var array<int>   exBi   = array.new_int()
var array<int>   exSide = array.new_int()
var array<float> exE    = array.new_float()
var array<float> exS    = array.new_float()
var array<float> exT    = array.new_float()
var array<int>   exOut  = array.new_int()
var array<int>   exAge  = array.new_int()

pushEx(int bi, int sSide, float e0, float s0, float t0) =>
    array.push(exBi, bi)
    array.push(exSide, sSide)
    array.push(exE, e0)
    array.push(exS, s0)
    array.push(exT, t0)
    array.push(exOut, 0)
    array.push(exAge, 0)
    // держим запас под histDraw
    maxKeep = histDraw + 5
    while array.size(exBi) > maxKeep
        array.shift(exBi)
        array.shift(exSide)
        array.shift(exE)
        array.shift(exS)
        array.shift(exT)
        array.shift(exOut)
        array.shift(exAge)

// только в бар самого тормоза
if barstate.isconfirmed and showHist and (brakeBot or brakeTop) and not na(entry) and side != 0
    pushEx(bar_index, side, entry, stop, take)

// исход считаем со СЛЕДУЮЩЕГО бара после сигнала
if showHist and array.size(exBi) > 0
    for i = 0 to array.size(exBi) - 1
        int o = array.get(exOut, i)
        int bi0 = array.get(exBi, i)
        if o == 0 and bar_index > bi0
            int age = array.get(exAge, i) + 1
            array.set(exAge, i, age)
            int sSide = array.get(exSide, i)
            float s0 = array.get(exS, i)
            float t0 = array.get(exT, i)
            if sSide == 1
                if low <= s0
                    array.set(exOut, i, -1)
                else if high >= t0
                    array.set(exOut, i, 1)
            else
                if high >= s0
                    array.set(exOut, i, -1)
                else if low <= t0
                    array.set(exOut, i, 1)
            if array.get(exOut, i) == 0 and age >= lookN
                array.set(exOut, i, 2)

var array<line> histLines = array.new_line()
var array<label> histLabs = array.new_label()

if barstate.islast and showHist
    if array.size(histLines) > 0
        for k = 0 to array.size(histLines) - 1
            line.delete(array.get(histLines, k))
        array.clear(histLines)
    if array.size(histLabs) > 0
        for k = 0 to array.size(histLabs) - 1
            label.delete(array.get(histLabs, k))
        array.clear(histLabs)

    nEx = array.size(exBi)
    if nEx > 0
        fromIdx = math.max(0, nEx - histDraw)
        for i = fromIdx to nEx - 1
            bi = array.get(exBi, i)
            sSide = array.get(exSide, i)
            e0 = array.get(exE, i)
            s0 = array.get(exS, i)
            t0 = array.get(exT, i)
            outc = array.get(exOut, i)
            x2 = bi + lookN
            cPlan = sSide == 1 ? colGo : colStop
            array.push(histLines, line.new(bi, e0, x2, e0, color = color.new(cPlan, 40), width = 2, style = line.style_dashed))
            array.push(histLines, line.new(bi, s0, x2, s0, color = color.new(colStop, 55), width = 1, style = line.style_dotted))
            array.push(histLines, line.new(bi, t0, x2, t0, color = color.new(colTp, 40), width = 2, style = line.style_dashed))
            array.push(histLines, line.new(bi, e0, bi + math.max(3, int(lookN * 0.35)), t0, color = color.new(colTp, 20), width = 2))
            res = outc == 1 ? "итог: ТЕЙК ✓" : outc == -1 ? "итог: СТОП ✗" : outc == 2 ? "итог: мимо" : "итог: ещё идёт"
            txt = (sSide == 1 ? "ЛОНГ" : "ШОРТ") + "\nвход " + str.tostring(e0, format.mintick) + "\nстоп " + str.tostring(s0, format.mintick) + "\nтейк " + str.tostring(t0, format.mintick) + "\n" + res
            array.push(histLabs, label.new(bi + 2, e0, txt, style = sSide == 1 ? label.style_label_up : label.style_label_down, color = color.new(outc == 1 ? colGo : outc == -1 ? colStop : colMiss, 10), textcolor = color.white, size = size.normal))
            array.push(histLabs, label.new(x2, t0, "ТЕЙК " + str.tostring(t0, format.mintick), style = label.style_label_left, color = color.new(colTp, 10), textcolor = color.white, size = size.small))

var line lnE = na
var line lnS = na
var line lnT = na
var label lb = na
var label lbE = na
var label lbS = na
var label lbT = na

if barstate.islast
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT)
    label.delete(lb)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lbT)
    x2 = bar_index + 6

    if status == "WAIT"
        lb := label.new(bar_index, close, "ЖДИ · сейчас не входи\nпример↑ = план вверх к тейку\nпример↓ = план вниз к тейку\nпунктир = план, подпись = куда реально", style = label.style_label_left, color = color.new(colWait, 0), textcolor = color.white, size = size.normal)
    else if status == "LATE"
        lb := label.new(bar_index, close, "ОПОЗДАЛ · не догоняй", style = label.style_label_left, color = color.new(colLate, 0), textcolor = color.white, size = size.large)
    else if status == "WAIT_FILL" or status == "NOW"
        sideTxt = side == 1 ? (status == "NOW" ? "ЛОНГ СЕЙЧАС" : "ЛОНГ · жди цену к входу") : (status == "NOW" ? "ШОРТ СЕЙЧАС" : "ШОРТ · жди цену к входу")
        col = side == 1 ? colGo : colStop
        lb := label.new(bar_index, entry, sideTxt + "\n" + mode + "\nсмотри 3 линии справа", style = label.style_label_left, color = color.new(col, 0), textcolor = color.white, size = size.large)
        lnE := line.new(nz(bornMem, bar_index), entry, x2, entry, color = colGo, width = 4)
        lnS := line.new(nz(bornMem, bar_index), stop, x2, stop, color = colStop, width = 3)
        lnT := line.new(nz(bornMem, bar_index), take, x2, take, color = colTp, width = 3)
        lbE := label.new(x2, entry, "1 ВХОД " + str.tostring(entry, format.mintick), style = label.style_label_left, color = colGo, textcolor = color.white, size = size.normal)
        lbS := label.new(x2, stop, "2 СТОП " + str.tostring(stop, format.mintick), style = label.style_label_left, color = colStop, textcolor = color.white, size = size.normal)
        lbT := label.new(x2, take, "3 ТЕЙК " + str.tostring(take, format.mintick), style = label.style_label_left, color = colTp, textcolor = color.white, size = size.normal)

var table t = table.new(position.top_right, 1, 3, bgcolor = color.new(#0B0E11, 0), border_width = 1, border_color = #2B3139)
if barstate.islast
    big = status == "NOW" ? (side == 1 ? "👉 ЛОНГ СЕЙЧАС" : "👉 ШОРТ СЕЙЧАС") : status == "LATE" ? "⛔ ОПОЗДАЛ" : status == "WAIT_FILL" ? "⏳ жди линию ВХОД" : "⏳ ЖДИ"
    table.cell(t, 0, 0, big, text_color = status == "NOW" ? colGo : status == "LATE" ? colLate : colNow, text_size = size.large)
    table.cell(t, 0, 1, haveSig ? (mode + "\nвход " + str.tostring(entry, format.mintick) + " | стоп " + str.tostring(stop, format.mintick) + " | тейк " + str.tostring(take, format.mintick)) : "нет тормоза · жди длинную тень + объём", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, "Алерт: колокол → этот индикатор → Once Per Bar Close → Any alert() function call", text_color = #848E9C, text_size = size.tiny)

newBrakeLong = brakeBot and not na(bornMem) and bar_index == bornMem and side == 1
newBrakeShort = brakeTop and not na(bornMem) and bar_index == bornMem and side == -1
goLong = status == "NOW" and side == 1 and not (status[1] == "NOW" and side[1] == 1)
goShort = status == "NOW" and side == -1 and not (status[1] == "NOW" and side[1] == -1)

if barstate.isconfirmed
    if newBrakeLong
        alert("ТОРМОЗ↑ ЛОНГ · " + syminfo.ticker + " · вход ~ " + str.tostring(entry, format.mintick) + " · стоп " + str.tostring(stop, format.mintick) + " · тейк " + str.tostring(take, format.mintick), alert.freq_once_per_bar_close)
    if newBrakeShort
        alert("ТОРМОЗ↓ ШОРТ · " + syminfo.ticker + " · вход ~ " + str.tostring(entry, format.mintick) + " · стоп " + str.tostring(stop, format.mintick) + " · тейк " + str.tostring(take, format.mintick), alert.freq_once_per_bar_close)
    if goLong and not newBrakeLong
        alert("ЛОНГ СЕЙЧАС · " + syminfo.ticker + " · цена у входа " + str.tostring(entry, format.mintick), alert.freq_once_per_bar_close)
    if goShort and not newBrakeShort
        alert("ШОРТ СЕЙЧАС · " + syminfo.ticker + " · цена у входа " + str.tostring(entry, format.mintick), alert.freq_once_per_bar_close)

alertcondition(newBrakeLong, title = "Тормоз лонг", message = "Тормоз снизу — смотри ЛОНГ")
alertcondition(newBrakeShort, title = "Тормоз шорт", message = "Тормоз сверху — смотри ШОРТ")
alertcondition(goLong, title = "Лонг сейчас", message = "ЛОНГ СЕЙЧАС — цена у входа")
alertcondition(goShort, title = "Шорт сейчас", message = "ШОРТ СЕЙЧАС — цена у входа")
