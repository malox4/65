//@version=6
// Урок 08.03.2023: защита уровня лимитником vs вход после ухода под/над зону + POC H4/D1/W1.
// Старые индикаторы уроков не трогаем — это ОТДЕЛЬНЫЙ файл.
indicator("Урок · Защита уровня", overlay = true, max_lines_count = 40, max_boxes_count = 10, max_labels_count = 40)

grpZ = "Зона"
swingLen   = input.int(5, "Swing для зоны", minval = 2, maxval = 20, group = grpZ)
zoneAtr    = input.float(0.35, "Толщина зоны × ATR", minval = 0.1, step = 0.05, group = grpZ)
nearAtr    = input.float(0.6, "«У зоны» если ≤ ATR×", minval = 0.2, step = 0.1, group = grpZ)
tpR        = input.float(2.0, "Тейк в R", minval = 0.5, step = 0.25, group = grpZ)
slPadAtr   = input.float(0.15, "Запас стопа × ATR", minval = 0.0, step = 0.05, group = grpZ)
atrLen     = input.int(14, "ATR", group = grpZ)
planBars   = input.int(30, "Держать план (свечей)", minval = 5, maxval = 80, group = grpZ)

grpP = "POC автоуровни (прокси)"
showPocH4 = input.bool(true, "POC H4", group = grpP)
showPocD1 = input.bool(true, "POC D1", group = grpP)
showPocW1 = input.bool(true, "POC W1", group = grpP)
pocLookH4 = input.int(48, "Окно H4 (баров H4)", minval = 12, maxval = 200, group = grpP)
pocLookD1 = input.int(30, "Окно D1 (баров D1)", minval = 10, maxval = 120, group = grpP)
pocLookW1 = input.int(26, "Окно W1 (баров W1)", minval = 8, maxval = 80, group = grpP)

grpF = "Фильтры (как Autotrade)"
useEngulf = input.bool(true, "Требовать поглощение у зоны (защита)", group = grpF)
useCci    = input.bool(false, "Фильтр CCI (Нехочуха)", group = grpF)
cciLen    = input.int(30, "CCI длина", group = grpF)
cciBuy    = input.float(-150.0, "CCI ≤ для лонг-защиты", group = grpF)
cciSell   = input.float(150.0, "CCI ≥ для шорт-защиты", group = grpF)

colZone  = input.color(color.new(#848E9C, 75), "Заливка зоны", group = grpZ)
colEdge  = input.color(#848E9C, "Край зоны", group = grpZ)
colDef   = input.color(#0ECB81, "Защита", group = grpZ)
colBrk   = input.color(#F0B90B, "Пробой", group = grpZ)
colStop  = input.color(#F6465D, "Стоп", group = grpZ)
colTp    = input.color(#3B82F6, "Тейк", group = grpZ)
colPocH4 = input.color(#F59E0B, "POC H4", group = grpP)
colPocD1 = input.color(#A855F7, "POC D1", group = grpP)
colPocW1 = input.color(#06B6D4, "POC W1", group = grpP)

atr = ta.atr(atrLen)
cci = ta.cci(hlc3, cciLen)

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

bullEng = close > open and close > high[1] and open <= low[1]
bearEng = close < open and close < low[1] and open >= high[1]

// ——— POC прокси: close бара с max volume на старшем ТФ ———
f_poc(string tf, int look) =>
    request.security(syminfo.tickerid, tf, close[ta.highestbars(volume, look)], lookahead = barmerge.lookahead_off)

pocH4 = showPocH4 ? f_poc("240", pocLookH4) : na
pocD1 = showPocD1 ? f_poc("D", pocLookD1) : na
pocW1 = showPocW1 ? f_poc("W", pocLookW1) : na

var line lnPocH4 = na
var line lnPocD1 = na
var line lnPocW1 = na
var label lbPocH4 = na
var label lbPocD1 = na
var label lbPocW1 = na

f_upd_poc(line ln, label lb, float px, color col, string nm) =>
    line nln = ln
    label nlb = lb
    if not na(px)
        if na(nln)
            nln := line.new(bar_index - 30, px, bar_index + 5, px, color = col, width = 1, style = line.style_dashed)
            nlb := label.new(bar_index + 5, px, nm, style = label.style_label_left, color = color.new(col, 30), textcolor = color.white, size = size.small)
        else
            line.set_xy1(nln, bar_index - 30, px)
            line.set_xy2(nln, bar_index + 5, px)
            label.set_xy(nlb, bar_index + 5, px)
            label.set_text(nlb, nm)
    [nln, nlb]

if barstate.islast
    [a, b] = f_upd_poc(lnPocH4, lbPocH4, pocH4, colPocH4, "POC H4")
    lnPocH4 := a
    lbPocH4 := b
    [c, d] = f_upd_poc(lnPocD1, lbPocD1, pocD1, colPocD1, "POC D1")
    lnPocD1 := c
    lbPocD1 := d
    [e, f] = f_upd_poc(lnPocW1, lbPocW1, pocW1, colPocW1, "POC W1")
    lnPocW1 := e
    lbPocW1 := f

// ——— рабочая зона от ближайшего свинга ———
var float zMid = na
var float zTop = na
var float zBot = na
var int   zDir = 0      // 1 = зона сверху (сопротивление), -1 = снизу (поддержка)
var int   phase = 0     // 0 idle, 1 wait, 2 defense, 3 break
var int   armedBar = na
var float entry = na
var float stop = na
var float take = na
var string dealName = ""
var string dealWhy = ""

var box zb = na
var line lnTop = na
var line lnBot = na
var line lnEntry = na
var line lnStop = na
var line lnTake = na
var label lbTop = na
var label lbBot = na
var label lbDeal = na

f_clear_plan() =>
    if not na(lnEntry)
        line.delete(lnEntry)
        lnEntry := na
    if not na(lnStop)
        line.delete(lnStop)
        lnStop := na
    if not na(lnTake)
        line.delete(lnTake)
        lnTake := na
    if not na(lbDeal)
        label.delete(lbDeal)
        lbDeal := na

f_set_zone(float mid, int dir) =>
    half = zoneAtr * atr
    zMid := mid
    zTop := mid + half
    zBot := mid - half
    zDir := dir
    phase := 1
    armedBar := na
    entry := na
    stop := na
    take := na
    dealName := ""
    dealWhy := ""
    f_clear_plan()
    if not na(zb)
        box.delete(zb)
    if not na(lnTop)
        line.delete(lnTop)
    if not na(lnBot)
        line.delete(lnBot)
    if not na(lbTop)
        label.delete(lbTop)
    if not na(lbBot)
        label.delete(lbBot)
    zb := box.new(bar_index - swingLen, zTop, bar_index + 3, zBot, bgcolor = colZone, border_color = colEdge, border_width = 1)
    lnTop := line.new(bar_index - swingLen, zTop, bar_index + 3, zTop, color = colEdge, width = 2)
    lnBot := line.new(bar_index - swingLen, zBot, bar_index + 3, zBot, color = colEdge, width = 2)
    lbTop := label.new(bar_index + 3, zTop, "ЗОНА ВЕРХ", style = label.style_label_left, color = color.new(colEdge, 20), textcolor = color.white, size = size.small)
    lbBot := label.new(bar_index + 3, zBot, "ЗОНА НИЗ", style = label.style_label_left, color = color.new(colEdge, 20), textcolor = color.white, size = size.small)

// новый свинг → зона
if not na(ph)
    if phase == 0 or phase == 1 or (phase >= 2 and bar_index - nz(armedBar, bar_index) > planBars)
        f_set_zone(ph, 1)

if not na(pl)
    closer = na(zMid) or math.abs(close - pl) < math.abs(close - zMid)
    if phase == 0 or (phase == 1 and closer) or (phase >= 2 and bar_index - nz(armedBar, bar_index) > planBars and closer)
        f_set_zone(pl, -1)

pad = slPadAtr * atr

f_arm(string name, string why, bool isDefense, float e, float s, float t, color dealCol) =>
    phase := isDefense ? 2 : 3
    armedBar := bar_index
    entry := e
    stop := s
    take := t
    dealName := name
    dealWhy := why
    f_clear_plan()
    lnEntry := line.new(bar_index, e, bar_index + 8, e, color = dealCol, width = 2)
    lnStop := line.new(bar_index, s, bar_index + 8, s, color = colStop, width = 2)
    lnTake := line.new(bar_index, t, bar_index + 8, t, color = colTp, width = 2)
    label.new(bar_index + 8, e, "ВХОД", style = label.style_label_left, color = color.new(dealCol, 10), textcolor = color.white, size = size.small)
    label.new(bar_index + 8, s, "СТОП", style = label.style_label_left, color = color.new(colStop, 10), textcolor = color.white, size = size.small)
    label.new(bar_index + 8, t, "ТЕЙК", style = label.style_label_left, color = color.new(colTp, 10), textcolor = color.white, size = size.small)
    lbDeal := label.new(bar_index, high + atr * 0.3, name + "\n" + why, style = label.style_label_down, color = color.new(dealCol, 10), textcolor = color.white, size = size.normal)

nearZone = not na(zTop) and close <= zTop + nearAtr * atr and close >= zBot - nearAtr * atr
cciOkLong = not useCci or cci <= cciBuy
cciOkShort = not useCci or cci >= cciSell

// защита: отбой от зоны
if phase == 1 and nearZone and not na(zMid)
    // поддержка снизу → лонг-защита
    if zDir == -1 and low <= zTop and close > zMid and close > open
        engOk = not useEngulf or bullEng
        if engOk and cciOkLong
            e = close
            s = zBot - pad
            risk = e - s
            if risk > 0
                t = e + tpR * risk
                // цель к ближайшему POC сверху если есть
                if not na(pocH4) and pocH4 > e
                    t := math.min(t, pocH4)
                f_arm("ЗАЩИТА · ЛОНГ", "лимит/отбой от зоны снизу", true, e, s, t, colDef)
                if useEngulf and bullEng
                    label.new(bar_index, low, "ПОГЛОЩЕНИЕ", style = label.style_label_up, color = color.new(colDef, 20), textcolor = color.white, size = size.tiny)
    // сопротивление сверху → шорт-защита
    if zDir == 1 and high >= zBot and close < zMid and close < open
        engOk = not useEngulf or bearEng
        if engOk and cciOkShort
            e = close
            s = zTop + pad
            risk = s - e
            if risk > 0
                t = e - tpR * risk
                if not na(pocH4) and pocH4 < e
                    t := math.max(t, pocH4)
                f_arm("ЗАЩИТА · ШОРТ", "лимит/отбой от зоны сверху", true, e, s, t, colDef)
                if useEngulf and bearEng
                    label.new(bar_index, high, "ПОГЛОЩЕНИЕ", style = label.style_label_down, color = color.new(colDef, 20), textcolor = color.white, size = size.tiny)

// пробой: цена ушла под/над зону
if phase == 1 and not na(zMid)
    // ушла под поддержку → шорт после пробоя
    if zDir == -1 and close < zBot and close[1] >= zBot
        e = close
        s = zTop + pad
        risk = s - e
        if risk > 0
            t = e - tpR * risk
            f_arm("ПРОБОЙ · ШОРТ", "вход после ухода ПОД зону", false, e, s, t, colBrk)
    // ушла над сопротивление → лонг после пробоя
    if zDir == 1 and close > zTop and close[1] <= zTop
        e = close
        s = zBot - pad
        risk = e - s
        if risk > 0
            t = e + tpR * risk
            f_arm("ПРОБОЙ · ЛОНГ", "вход после ухода НАД зону", false, e, s, t, colBrk)

// тянуть бокс/края
if barstate.islast and not na(zb) and not na(zTop)
    box.set_right(zb, bar_index + 3)
    line.set_x2(lnTop, bar_index + 3)
    line.set_x2(lnBot, bar_index + 3)
    label.set_x(lbTop, bar_index + 3)
    label.set_x(lbBot, bar_index + 3)
    if not na(lnEntry)
        line.set_x2(lnEntry, bar_index + 8)
        line.set_x2(lnStop, bar_index + 8)
        line.set_x2(lnTake, bar_index + 8)

// сброс устаревшего плана
if phase >= 2 and not na(armedBar) and bar_index - armedBar > planBars
    phase := 0
    f_clear_plan()

// таблица
var table tb = table.new(position.top_right, 2, 8, bgcolor = color.new(#0B0E11, 10), border_width = 1, border_color = #2B3139)
if barstate.islast
    table.cell(tb, 0, 0, "Урок · Защита уровня", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, "08.03", text_color = #848E9C, text_size = size.small)
    phaseTxt = phase == 0 ? "нет зоны" : phase == 1 ? "жди у зоны" : phase == 2 ? "ЗАЩИТА" : "ПРОБОЙ"
    table.cell(tb, 0, 1, "Фаза", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 1, phaseTxt, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Сделка", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 2, dealName == "" ? "—" : dealName, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Почему", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 3, dealWhy == "" ? "—" : dealWhy, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "Вход", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 4, na(entry) ? "—" : str.tostring(entry, format.mintick), text_color = colDef, text_size = size.small)
    table.cell(tb, 0, 5, "Стоп / Тейк", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 5, na(stop) ? "—" : str.tostring(stop, format.mintick) + " / " + str.tostring(take, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 6, "POC H4/D1/W1", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 6, (na(pocH4) ? "—" : str.tostring(pocH4, format.mintick)) + " / " + (na(pocD1) ? "—" : str.tostring(pocD1, format.mintick)) + " / " + (na(pocW1) ? "—" : str.tostring(pocW1, format.mintick)), text_color = color.white, text_size = size.tiny)
    table.cell(tb, 0, 7, "CCI", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 7, str.tostring(cci, "#.#"), text_color = color.white, text_size = size.small)

alertcondition(phase == 2 and bar_index == armedBar, "Защита уровня", "Урок: сценарий ЗАЩИТА уровня")
alertcondition(phase == 3 and bar_index == armedBar, "Пробой зоны", "Урок: вход после ухода за зону")
