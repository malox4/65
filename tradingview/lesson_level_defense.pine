//@version=6
// Урок 08.03 — максимально просто.
// На графике только то, что можно сделать СЕЙЧАС.
// Событие на этой/прошлой свече → вход/стоп/тейк.
// Цена уже ушла → «опоздал». Иначе → «жди».
indicator("Урок · Защита уровня", overlay = true, max_lines_count = 12, max_boxes_count = 3, max_labels_count = 12)

grp = "План"
swingLen = input.int(5, "Swing", minval = 2, maxval = 12, group = grp)
zoneAtr  = input.float(0.3, "Толщина зоны × ATR", minval = 0.1, step = 0.05, group = grp)
tpR      = input.float(2.0, "Тейк = риск ×", minval = 1.0, step = 0.5, group = grp)
slPad    = input.float(0.1, "Стоп запас × ATR", minval = 0.0, step = 0.05, group = grp)
liveAtr  = input.float(0.35, "СЕЙЧАС только если цена ≤ ATR× от входа", minval = 0.1, step = 0.05, group = grp)
freshBars = input.int(2, "Сигнал свежий N свечей", minval = 1, maxval = 5, group = grp)
atrLen   = input.int(14, "ATR", group = grp)
needEng  = input.bool(true, "Защите нужно поглощение", group = grp)

colZ = #848E9C
colGo = #0ECB81
colStop = #F6465D
colTp = #3B82F6
colWait = #848E9C
colLate = #F6465D
colBrk = #F0B90B

atr = ta.atr(atrLen)
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
bull = close > open and close > high[1] and open <= low[1]
bear = close < open and close < low[1] and open >= high[1]

var float zTop = na
var float zBot = na
var float zMid = na
var int zDir = 0
var int zBorn = na

half = zoneAtr * atr
pad = slPad * atr

// зона обновляется спокойно, без сделки
if not na(ph)
    if na(zMid) or math.abs(close - ph) <= math.abs(close - nz(zMid))
        zMid := ph
        zTop := ph + half
        zBot := ph - half
        zDir := 1
        zBorn := bar_index - swingLen

if not na(pl)
    if na(zMid) or math.abs(close - pl) < math.abs(close - nz(zMid))
        zMid := pl
        zTop := pl + half
        zBot := pl - half
        zDir := -1
        zBorn := bar_index - swingLen

// ——— события только «сейчас» (не копим старый план) ———
float entry = na
float stop = na
float take = na
int side = 0          // 1 long -1 short
string mode = ""      // ЗАЩИТА / ПРОБОЙ
int age = 1000

// защита: отбой на этой свече
defLong = not na(zMid) and zDir == -1 and low <= zTop and close > zMid and close > open and (not needEng or bull)
defShort = not na(zMid) and zDir == 1 and high >= zBot and close < zMid and close < open and (not needEng or bear)

if defLong
    entry := zMid
    stop := zBot - pad
    risk = entry - stop
    if risk > 0
        take := entry + tpR * risk
        side := 1
        mode := "ЗАЩИТА"
        age := 0

if defShort and na(entry)
    entry := zMid
    stop := zTop + pad
    risk = stop - entry
    if risk > 0
        take := entry - tpR * risk
        side := -1
        mode := "ЗАЩИТА"
        age := 0

// пробой: уход из зоны на этой свече
brkShort = not na(zBot) and zDir == -1 and close < zBot and close[1] >= zBot
brkLong = not na(zTop) and zDir == 1 and close > zTop and close[1] <= zTop

if brkShort and na(entry)
    entry := zBot
    stop := zTop + pad
    risk = stop - entry
    if risk > 0
        take := entry - tpR * risk
        side := -1
        mode := "ПРОБОЙ"
        age := 0

if brkLong and na(entry)
    entry := zTop
    stop := zBot - pad
    risk = entry - stop
    if risk > 0
        take := entry + tpR * risk
        side := 1
        mode := "ПРОБОЙ"
        age := 0

// помнить сигнал N свечей (чтобы успеть увидеть), но считать «свежесть»
var float eMem = na
var float sMem = na
var float tMem = na
var int sideMem = 0
var string modeMem = ""
var int bornMem = na

if not na(entry)
    eMem := entry
    sMem := stop
    tMem := take
    sideMem := side
    modeMem := mode
    bornMem := bar_index

sigAge = na(bornMem) ? 1000 : bar_index - bornMem
haveSig = not na(eMem) and sigAge <= freshBars

if haveSig
    entry := eMem
    stop := sMem
    take := tMem
    side := sideMem
    mode := modeMem
else
    eMem := na
    sMem := na
    tMem := na
    sideMem := 0
    modeMem := ""
    bornMem := na
    entry := na
    stop := na
    take := na
    side := 0
    mode := ""

// цена у входа?
nearEntry = haveSig and not na(atr) and math.abs(close - entry) <= liveAtr * atr
// ушла дальше в прибыль сделки = опоздал догонять
late = haveSig and not nearEntry and (side == 1 ? close > entry : close < entry)
// ещё не дошла до входа (для шорта цена ниже зоны уже = late; выше входа = можно лимит)
canNow = haveSig and nearEntry

status = not haveSig ? "WAIT" : canNow ? "NOW" : late ? "LATE" : "WAIT_FILL"

// ——— рисунок ———
var box bx = na
var line lnE = na
var line lnS = na
var line lnT = na
var label lb = na
var label lbE = na
var label lbS = na
var label lbT = na

if barstate.islast
    box.delete(bx)
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT)
    label.delete(lb)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lbT)

    x2 = bar_index + 8
    if not na(zTop) and not na(zBorn)
        bx := box.new(math.max(zBorn, bar_index - 20), zTop, x2, zBot, bgcolor = color.new(colZ, 85), border_color = color.new(colZ, 40), border_width = 1)

    if status == "WAIT"
        lb := label.new(x2, close, "ЖДИ\nсделки нет\nнужен отбой от зоны\nили уход ИЗ зоны", style = label.style_label_left, color = color.new(colWait, 15), textcolor = color.white, size = size.normal)
    else if status == "LATE"
        lb := label.new(x2, close, "ОПОЗДАЛ\nне догоняй\nжди новую зону", style = label.style_label_left, color = color.new(colLate, 5), textcolor = color.white, size = size.large)
    else if status == "WAIT_FILL"
        sideTxt = side == 1 ? "ЛОНГ" : "ШОРТ"
        lb := label.new(x2, entry, mode + " " + sideTxt + "\nжди цену К зелёной\nне бери рынок в воздухе", style = label.style_label_left, color = color.new(colBrk, 10), textcolor = color.white, size = size.normal)
        lnE := line.new(bar_index - 3, entry, x2, entry, color = colGo, width = 3)
        lnS := line.new(bar_index - 3, stop, x2, stop, color = colStop, width = 2)
        lnT := line.new(bar_index - 3, take, x2, take, color = colTp, width = 2)
        lbE := label.new(x2, entry, "ВХОД " + str.tostring(entry, format.mintick), style = label.style_label_left, color = colGo, textcolor = color.white, size = size.normal)
        lbS := label.new(x2, stop, "СТОП " + str.tostring(stop, format.mintick), style = label.style_label_left, color = colStop, textcolor = color.white, size = size.small)
        lbT := label.new(x2, take, "ТЕЙК " + str.tostring(take, format.mintick), style = label.style_label_left, color = colTp, textcolor = color.white, size = size.small)
    else  // NOW
        sideTxt = side == 1 ? "ЛОНГ СЕЙЧАС" : "ШОРТ СЕЙЧАС"
        col = mode == "ЗАЩИТА" ? colGo : colBrk
        lb := label.new(x2, entry, sideTxt + "\n" + mode + "\n1 вход  2 стоп  3 тейк", style = label.style_label_left, color = color.new(col, 0), textcolor = color.white, size = size.large)
        lnE := line.new(bar_index - 3, entry, x2, entry, color = colGo, width = 4)
        lnS := line.new(bar_index - 3, stop, x2, stop, color = colStop, width = 3)
        lnT := line.new(bar_index - 3, take, x2, take, color = colTp, width = 3)
        lbE := label.new(x2, entry, "1 ВХОД " + str.tostring(entry, format.mintick), style = label.style_label_left, color = colGo, textcolor = color.white, size = size.normal)
        lbS := label.new(x2, stop, "2 СТОП " + str.tostring(stop, format.mintick), style = label.style_label_left, color = colStop, textcolor = color.white, size = size.normal)
        lbT := label.new(x2, take, "3 ТЕЙК " + str.tostring(take, format.mintick), style = label.style_label_left, color = colTp, textcolor = color.white, size = size.normal)

var table t = table.new(position.bottom_right, 1, 4, bgcolor = color.new(#0B0E11, 5), border_width = 1, border_color = #2B3139)
if barstate.islast
    big = status == "NOW" ? (side == 1 ? "👉 ЛОНГ СЕЙЧАС" : "👉 ШОРТ СЕЙЧАС") : status == "LATE" ? "⛔ ОПОЗДАЛ — не входи" : status == "WAIT_FILL" ? "⏳ жди цену к зелёной линии" : "⏳ ЖДИ — сделки нет"
    table.cell(t, 0, 0, big, text_color = status == "NOW" ? colGo : status == "LATE" ? colLate : #F0B90B, text_size = size.large)
    table.cell(t, 0, 1, status == "NOW" or status == "WAIT_FILL" ? ("вход " + str.tostring(entry, format.mintick) + " | стоп " + str.tostring(stop, format.mintick) + " | тейк " + str.tostring(take, format.mintick)) : "урок: отбой от зоны = защита, уход из зоны = пробой", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, "не бери вход «в воздухе» — только у зелёной или СЕЙЧАС", text_color = #848E9C, text_size = size.tiny)
    table.cell(t, 0, 3, "файл: tradingview/lesson_level_defense.pine", text_color = #848E9C, text_size = size.tiny)

alertcondition(status == "NOW" and mode == "ЗАЩИТА", "Сейчас защита", "Вход СЕЙЧАС — защита уровня")
alertcondition(status == "NOW" and mode == "ПРОБОЙ", "Сейчас пробой", "Вход СЕЙЧАС — пробой зоны")
