//@version=6
// Урок 08.03.2023: защита уровня лимитником vs вход после ухода под/над зону + POC H4/D1/W1.
// Старые индикаторы уроков не трогаем — это ОТДЕЛЬНЫЙ файл.
indicator("Урок · Защита уровня", overlay = true, max_lines_count = 40, max_boxes_count = 10, max_labels_count = 40)

grpZ = "Зона"
swingLen   = input.int(5, "Swing для зоны", minval = 2, maxval = 20, group = grpZ)
zoneAtr    = input.float(0.35, "Толщина зоны × ATR", minval = 0.1, step = 0.05, group = grpZ)
nearAtr    = input.float(0.6, "«У зоны» если ≤ ATR×", minval = 0.2, step = 0.1, group = grpZ)
tpR        = input.float(2.0, "Тейк в R", minval = 0.5, step = 0.25, group = grpZ)
slPadAtr   = input.float(0.15, "Запас стопа × ATR", minval = 0.0, step = 0.05, group = grpZ)
atrLen     = input.int(14, "ATR", group = grpZ)
planBars   = input.int(30, "Держать план (свечей)", minval = 5, maxval = 80, group = grpZ)

grpP = "POC автоуровни (прокси)"
showPocH4 = input.bool(true, "POC H4", group = grpP)
showPocD1 = input.bool(true, "POC D1", group = grpP)
showPocW1 = input.bool(true, "POC W1", group = grpP)
pocLookH4 = input.int(48, "Окно H4 (баров H4)", minval = 12, maxval = 200, group = grpP)
pocLookD1 = input.int(30, "Окно D1 (баров D1)", minval = 10, maxval = 120, group = grpP)
pocLookW1 = input.int(26, "Окно W1 (баров W1)", minval = 8, maxval = 80, group = grpP)

grpF = "Фильтры (как Autotrade)"
useEngulf = input.bool(true, "Требовать поглощение у зоны (защита)", group = grpF)
useCci    = input.bool(false, "Фильтр CCI (Нехочуха)", group = grpF)
cciLen    = input.int(30, "CCI длина", group = grpF)
cciBuy    = input.float(-150.0, "CCI ≤ для лонг-защиты", group = grpF)
cciSell   = input.float(150.0, "CCI ≥ для шорт-защиты", group = grpF)

colZone  = input.color(color.new(#848E9C, 75), "Заливка зоны", group = grpZ)
colEdge  = input.color(#848E9C, "Край зоны", group = grpZ)
colDef   = input.color(#0ECB81, "Защита", group = grpZ)
colBrk   = input.color(#F0B90B, "Пробой", group = grpZ)
colStop  = input.color(#F6465D, "Стоп", group = grpZ)
colTp    = input.color(#3B82F6, "Тейк", group = grpZ)
colPocH4 = input.color(#F59E0B, "POC H4", group = grpP)
colPocD1 = input.color(#A855F7, "POC D1", group = grpP)
colPocW1 = input.color(#06B6D4, "POC W1", group = grpP)

atr = ta.atr(atrLen)
cci = ta.cci(hlc3, cciLen)

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

bullEng = close > open and close > high[1] and open <= low[1]
bearEng = close < open and close < low[1] and open >= high[1]

// POC прокси: close бара с max volume на старшем ТФ (без close[offset] — RE10008)
f_poc(int look) =>
    hv = ta.highest(volume, look)
    ta.valuewhen(volume == hv, close, 0)

pocH4 = showPocH4 ? request.security(syminfo.tickerid, "240", f_poc(pocLookH4), lookahead = barmerge.lookahead_off) : na
pocD1 = showPocD1 ? request.security(syminfo.tickerid, "D", f_poc(pocLookD1), lookahead = barmerge.lookahead_off) : na
pocW1 = showPocW1 ? request.security(syminfo.tickerid, "W", f_poc(pocLookW1), lookahead = barmerge.lookahead_off) : na

var float zMid = na
var float zTop = na
var float zBot = na
var int   zDir = 0      // 1 сопротивление сверху, -1 поддержка снизу
var int   zBorn = na
var int   phase = 0     // 0 idle, 1 wait, 2 defense, 3 break
var int   armedBar = na
var float entry = na
var float stop = na
var float take = na
var string dealName = ""
var string dealWhy = ""
var color dealCol = #0ECB81

pad = slPadAtr * atr
half = zoneAtr * atr

// новый свинг → зона (только global scope)
if not na(ph)
    if phase == 0 or phase == 1 or (phase >= 2 and not na(armedBar) and bar_index - armedBar > planBars)
        zMid := ph
        zTop := ph + half
        zBot := ph - half
        zDir := 1
        zBorn := bar_index - swingLen
        phase := 1
        armedBar := na
        entry := na
        stop := na
        take := na
        dealName := ""
        dealWhy := ""

if not na(pl)
    closer = na(zMid) or math.abs(close - pl) < math.abs(close - zMid)
    expired = phase >= 2 and not na(armedBar) and bar_index - armedBar > planBars
    if phase == 0 or (phase == 1 and closer) or (expired and closer)
        zMid := pl
        zTop := pl + half
        zBot := pl - half
        zDir := -1
        zBorn := bar_index - swingLen
        phase := 1
        armedBar := na
        entry := na
        stop := na
        take := na
        dealName := ""
        dealWhy := ""

nearZone = not na(zTop) and close <= zTop + nearAtr * atr and close >= zBot - nearAtr * atr
cciOkLong = not useCci or cci <= cciBuy
cciOkShort = not useCci or cci >= cciSell

// защита: отбой от зоны
if phase == 1 and nearZone and not na(zMid)
    if zDir == -1 and low <= zTop and close > zMid and close > open
        engOk = not useEngulf or bullEng
        if engOk and cciOkLong
            e = close
            s = zBot - pad
            risk = e - s
            if risk > 0
                t = e + tpR * risk
                if not na(pocH4) and pocH4 > e
                    t := math.min(t, pocH4)
                phase := 2
                armedBar := bar_index
                entry := e
                stop := s
                take := t
                dealName := "ЗАЩИТА · ЛОНГ"
                dealWhy := "лимит/отбой от зоны снизу"
                dealCol := colDef
    if phase == 1 and zDir == 1 and high >= zBot and close < zMid and close < open
        engOk = not useEngulf or bearEng
        if engOk and cciOkShort
            e = close
            s = zTop + pad
            risk = s - e
            if risk > 0
                t = e - tpR * risk
                if not na(pocH4) and pocH4 < e
                    t := math.max(t, pocH4)
                phase := 2
                armedBar := bar_index
                entry := e
                stop := s
                take := t
                dealName := "ЗАЩИТА · ШОРТ"
                dealWhy := "лимит/отбой от зоны сверху"
                dealCol := colDef

// пробой: цена ушла под/над зону
if phase == 1 and not na(zMid)
    if zDir == -1 and close < zBot and close[1] >= zBot
        e = close
        s = zTop + pad
        risk = s - e
        if risk > 0
            phase := 3
            armedBar := bar_index
            entry := e
            stop := s
            take := e - tpR * risk
            dealName := "ПРОБОЙ · ШОРТ"
            dealWhy := "вход после ухода ПОД зону"
            dealCol := colBrk
    if phase == 1 and zDir == 1 and close > zTop and close[1] <= zTop
        e = close
        s = zBot - pad
        risk = e - s
        if risk > 0
            phase := 3
            armedBar := bar_index
            entry := e
            stop := s
            take := e + tpR * risk
            dealName := "ПРОБОЙ · ЛОНГ"
            dealWhy := "вход после ухода НАД зону"
            dealCol := colBrk

// сброс устаревшего плана
if phase >= 2 and not na(armedBar) and bar_index - armedBar > planBars
    phase := 0
    entry := na
    stop := na
    take := na
    dealName := ""
    dealWhy := ""

justDefLong = phase == 2 and phase[1] == 1 and dealName == "ЗАЩИТА · ЛОНГ"
justDefShort = phase == 2 and phase[1] == 1 and dealName == "ЗАЩИТА · ШОРТ"
justBrk = phase == 3 and phase[1] == 1

plotshape(justDefLong, title = "Защита лонг", style = shape.triangleup, location = location.belowbar, color = colDef, size = size.small, text = "ЗАЩИТА", textcolor = colDef)
plotshape(justDefShort, title = "Защита шорт", style = shape.triangledown, location = location.abovebar, color = colDef, size = size.small, text = "ЗАЩИТА", textcolor = colDef)
plotshape(justBrk and str.contains(dealName, "ЛОНГ"), title = "Пробой лонг", style = shape.triangleup, location = location.belowbar, color = colBrk, size = size.small, text = "ПРОБОЙ", textcolor = colBrk)
plotshape(justBrk and str.contains(dealName, "ШОРТ"), title = "Пробой шорт", style = shape.triangledown, location = location.abovebar, color = colBrk, size = size.small, text = "ПРОБОЙ", textcolor = colBrk)
plotshape(justDefLong and useEngulf and bullEng, title = "Поглощение", style = shape.circle, location = location.belowbar, color = colDef, size = size.tiny, text = "ПОГЛОЩЕНИЕ", textcolor = colDef)
plotshape(justDefShort and useEngulf and bearEng, title = "Поглощение шорт", style = shape.circle, location = location.abovebar, color = colDef, size = size.tiny, text = "ПОГЛОЩЕНИЕ", textcolor = colDef)

// рисунок только на последнем баре
var line lnTop = na
var line lnBot = na
var line lnEntry = na
var line lnStop = na
var line lnTake = na
var line lnPocH4 = na
var line lnPocD1 = na
var line lnPocW1 = na
var box zb = na
var label lbTop = na
var label lbBot = na
var label lbDeal = na
var label lbEntry = na
var label lbStop = na
var label lbTake = na
var label lbPocH4 = na
var label lbPocD1 = na
var label lbPocW1 = na

if barstate.islast
    line.delete(lnTop)
    line.delete(lnBot)
    line.delete(lnEntry)
    line.delete(lnStop)
    line.delete(lnTake)
    line.delete(lnPocH4)
    line.delete(lnPocD1)
    line.delete(lnPocW1)
    box.delete(zb)
    label.delete(lbTop)
    label.delete(lbBot)
    label.delete(lbDeal)
    label.delete(lbEntry)
    label.delete(lbStop)
    label.delete(lbTake)
    label.delete(lbPocH4)
    label.delete(lbPocD1)
    label.delete(lbPocW1)

    x2 = bar_index + 8
    if phase != 0 and not na(zTop) and not na(zBorn)
        zb := box.new(zBorn, zTop, x2, zBot, bgcolor = colZone, border_color = colEdge, border_width = 1)
        lnTop := line.new(zBorn, zTop, x2, zTop, color = colEdge, width = 2)
        lnBot := line.new(zBorn, zBot, x2, zBot, color = colEdge, width = 2)
        lbTop := label.new(x2, zTop, "ЗОНА ВЕРХ", style = label.style_label_left, color = color.new(colEdge, 20), textcolor = color.white, size = size.small)
        lbBot := label.new(x2, zBot, "ЗОНА НИЗ", style = label.style_label_left, color = color.new(colEdge, 20), textcolor = color.white, size = size.small)

        if phase >= 2 and not na(entry) and not na(stop) and not na(take) and not na(armedBar)
            lnEntry := line.new(armedBar, entry, x2, entry, color = dealCol, width = 2)
            lnStop := line.new(armedBar, stop, x2, stop, color = colStop, width = 2)
            lnTake := line.new(armedBar, take, x2, take, color = colTp, width = 2)
            lbEntry := label.new(x2, entry, "ВХОД", style = label.style_label_left, color = color.new(dealCol, 10), textcolor = color.white, size = size.small)
            lbStop := label.new(x2, stop, "СТОП", style = label.style_label_left, color = color.new(colStop, 10), textcolor = color.white, size = size.small)
            lbTake := label.new(x2, take, "ТЕЙК", style = label.style_label_left, color = color.new(colTp, 10), textcolor = color.white, size = size.small)
            lbDeal := label.new(bar_index + 2, zMid, dealName + "\n" + dealWhy, style = label.style_label_left, color = color.new(dealCol, 10), textcolor = color.white, size = size.normal)

    if showPocH4 and not na(pocH4)
        lnPocH4 := line.new(bar_index - 40, pocH4, x2, pocH4, color = colPocH4, width = 1, style = line.style_dashed)
        lbPocH4 := label.new(x2, pocH4, "POC H4", style = label.style_label_left, color = color.new(colPocH4, 30), textcolor = color.white, size = size.small)
    if showPocD1 and not na(pocD1)
        lnPocD1 := line.new(bar_index - 40, pocD1, x2, pocD1, color = colPocD1, width = 1, style = line.style_dashed)
        lbPocD1 := label.new(x2, pocD1, "POC D1", style = label.style_label_left, color = color.new(colPocD1, 30), textcolor = color.white, size = size.small)
    if showPocW1 and not na(pocW1)
        lnPocW1 := line.new(bar_index - 40, pocW1, x2, pocW1, color = colPocW1, width = 1, style = line.style_dashed)
        lbPocW1 := label.new(x2, pocW1, "POC W1", style = label.style_label_left, color = color.new(colPocW1, 30), textcolor = color.white, size = size.small)

var table tb = table.new(position.top_right, 2, 8, bgcolor = color.new(#0B0E11, 10), border_width = 1, border_color = #2B3139)
if barstate.islast
    table.cell(tb, 0, 0, "Урок · Защита уровня", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, "08.03", text_color = #848E9C, text_size = size.small)
    phaseTxt = phase == 0 ? "нет зоны" : phase == 1 ? "жди у зоны" : phase == 2 ? "ЗАЩИТА" : "ПРОБОЙ"
    table.cell(tb, 0, 1, "Фаза", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 1, phaseTxt, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Сделка", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 2, dealName == "" ? "—" : dealName, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Почему", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 3, dealWhy == "" ? "—" : dealWhy, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "Вход", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 4, na(entry) ? "—" : str.tostring(entry, format.mintick), text_color = colDef, text_size = size.small)
    table.cell(tb, 0, 5, "Стоп / Тейк", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 5, na(stop) ? "—" : str.tostring(stop, format.mintick) + " / " + str.tostring(take, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 6, "POC H4/D1/W1", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 6, (na(pocH4) ? "—" : str.tostring(pocH4, format.mintick)) + " / " + (na(pocD1) ? "—" : str.tostring(pocD1, format.mintick)) + " / " + (na(pocW1) ? "—" : str.tostring(pocW1, format.mintick)), text_color = color.white, text_size = size.tiny)
    table.cell(tb, 0, 7, "CCI", text_color = #848E9C, text_size = size.small)
    table.cell(tb, 1, 7, str.tostring(cci, "#.#"), text_color = color.white, text_size = size.small)

alertcondition(phase == 2 and phase[1] == 1, "Защита уровня", "Урок: сценарий ЗАЩИТА уровня")
alertcondition(phase == 3 and phase[1] == 1, "Пробой зоны", "Урок: вход после ухода за зону")
