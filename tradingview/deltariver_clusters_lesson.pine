//@version=6
// Урок 03.03.2023 · кластеры / дельта в тенях (учебный)
// Если LTF пустой — считается по теням самой свечи (чтобы график НЕ был пустым).
indicator("Урок · Кластеры DeltaRiver", overlay = true, max_labels_count = 40)

grp = "Урок"
sensitivity = input.float(1.2, "Чувствительность (ниже = больше меток)", minval = 0.5, maxval = 3.0, step = 0.1, group = grp, tooltip = "1.0–1.3 обычно видно метки. Выше 2 — почти пусто.")
ltf         = input.timeframe("1", "LTF (если биржа отдаёт)", group = grp)
useLtf      = input.bool(true, "Пробовать LTF", group = grp)
showWeak    = input.bool(true, "Мелкие точки фильтра", group = grp)
showStrong  = input.bool(true, "ЛОНГ / ШОРТ", group = grp)
showHelp    = input.bool(true, "Таблица-подсказка", group = grp)

// ── объём в верхней / нижней части бара ─────────────────────────────────
f_split(o, h, l, c, v) =>
    rng = h - l
    float buy = 0.0
    float sell = 0.0
    if na(v) or v <= 0 or na(rng) or rng <= 0
        buy := 0.0
        sell := 0.0
    else
        buy := v * (c - l) / rng
        sell := v * (h - c) / rng
    [buy, sell]

float buyUp = 0.0
float sellLo = 0.0
bool ltfOk = false

if useLtf
    ltfO = request.security_lower_tf(syminfo.tickerid, ltf, open)
    ltfH = request.security_lower_tf(syminfo.tickerid, ltf, high)
    ltfL = request.security_lower_tf(syminfo.tickerid, ltf, low)
    ltfC = request.security_lower_tf(syminfo.tickerid, ltf, close)
    ltfV = request.security_lower_tf(syminfo.tickerid, ltf, volume)
    n = array.size(ltfC)
    mid = (high + low) / 2.0
    if n > 0
        ltfOk := true
        for i = 0 to n - 1
            [b, s] = f_split(array.get(ltfO, i), array.get(ltfH, i), array.get(ltfL, i), array.get(ltfC, i), array.get(ltfV, i))
            px = (array.get(ltfH, i) + array.get(ltfL, i)) / 2.0
            if px >= mid
                buyUp += b
            if px <= mid
                sellLo += s

// fallback: по теням текущей свечи (всегда есть данные)
rng = high - low
upperW = high - math.max(open, close)
lowerW = math.min(open, close) - low
if not ltfOk and rng > 0 and not na(volume)
    buyUp := volume * upperW / rng
    sellLo := volume * lowerW / rng

// порог от истории самих метрик — чтобы на любой монете что-то зажигалось
buyBase = ta.sma(buyUp, 20)
sellBase = ta.sma(sellLo, 20)
buyThr = nz(buyBase, buyUp) * sensitivity
sellThr = nz(sellBase, sellLo) * sensitivity

volSma = ta.sma(volume, 20)
volOk = na(volSma) or volume >= volSma * 0.8

isBear = close < open
isBull = close > open
swingLo = ta.lowest(low, 5)[1]
swingHi = ta.highest(high, 5)[1]

// слабый фильтр (точки) — просто «в тени много»
weakShort = buyUp > buyThr and upperW > rng * 0.15 and volOk
weakLong  = sellLo > sellThr and lowerW > rng * 0.15 and volOk

// сильный — как идея урока + экстремум
shortIdea = weakShort and isBear and high >= swingHi
longIdea  = weakLong and isBull and low <= swingLo

plotshape(showWeak and weakLong and not longIdea, title = "SellΔ низ", style = shape.circle, location = location.belowbar, color = color.new(#0ECB81, 40), size = size.tiny)
plotshape(showWeak and weakShort and not shortIdea, title = "BuyΔ верх", style = shape.circle, location = location.abovebar, color = color.new(#F6465D, 40), size = size.tiny)
plotshape(showStrong and longIdea, title = "ЛОНГ", style = shape.triangleup, location = location.belowbar, color = #0ECB81, size = size.normal, text = "ЛОНГ", textcolor = #0ECB81)
plotshape(showStrong and shortIdea, title = "ШОРТ", style = shape.triangledown, location = location.abovebar, color = #F6465D, size = size.normal, text = "ШОРТ", textcolor = #F6465D)

bgcolor(longIdea ? color.new(#0ECB81, 90) : shortIdea ? color.new(#F6465D, 90) : na)

var table t = table.new(position.top_right, 1, 7, bgcolor = color.new(#FFFFFF, 10), border_width = 1, border_color = #B7BDC6)
if showHelp and barstate.islast
    mode = ltfOk ? "LTF ок" : "режим теней (LTF пуст)"
    table.cell(t, 0, 0, "УРОК КЛАСТЕРЫ · " + mode, text_color = #F0B90B, text_size = size.normal)
    table.cell(t, 0, 1, "Точка внизу = продажи в нижней тени", text_color = #0ECB81, text_size = size.small)
    table.cell(t, 0, 2, "Точка вверху = покупки в верхней тени", text_color = #F6465D, text_size = size.small)
    table.cell(t, 0, 3, "▲ ЛОНГ / ▼ ШОРТ = идея у хая/лоя", text_color = #181A20, text_size = size.small)
    table.cell(t, 0, 4, "Buy↑ " + str.tostring(buyUp, format.volume) + "  порог " + str.tostring(buyThr, format.volume), text_color = #848E9C, text_size = size.tiny)
    table.cell(t, 0, 5, "Sell↓ " + str.tostring(sellLo, format.volume) + "  порог " + str.tostring(sellThr, format.volume), text_color = #848E9C, text_size = size.tiny)
    table.cell(t, 0, 6, "Чувств. " + str.tostring(sensitivity, "#.#") + " · если пусто — поставь 0.8", text_color = #F0B90B, text_size = size.tiny)

alertcondition(longIdea, "ЛОНГ", "SellΔ в нижней тени у лоя")
alertcondition(shortIdea, "ШОРТ", "BuyΔ в верхней тени у хая")
